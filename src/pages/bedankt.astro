---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Bedankt — MonkAi Business" description="Bedankt voor je bericht. Ik antwoord binnen twee werkdagen." noindex={true}>
  <Nav />
  <main class="section thanks">
    <div class="container thanks-inner">
      <h1>Bedankt voor je bericht</h1>
      <p>Ik antwoord binnen twee werkdagen.</p>
      <a href="/" class="btn">Terug naar de homepage</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
<script is:inline>
  // Primaire conversie: het contactformulier is verstuurd (Netlify leidt hierheen door).
  // De PostHog-stub is synchroon beschikbaar; het event wordt gequeued tot de lib geladen is.
  //
  // /bedankt is een statische pagina en dus ook rechtstreeks op te vragen. Meet de
  // conversie daarom op dit event en niet op de pageview van deze pagina, en filter
  // hier het ruis eruit:
  // - een refresh of terug/vooruit mag de conversie niet dubbel tellen
  // - een directe GET (geen referrer, of een referrer van buiten de site) telt niet mee
  (function () {
    var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
    if (nav && (nav.type === 'reload' || nav.type === 'back_forward')) return;
    var ref = document.referrer || '';
    if (ref.indexOf(window.location.origin + '/') !== 0) return;
    if (ref.indexOf(window.location.origin + '/bedankt') === 0) return;
    window.posthog?.capture('contact_submitted');
  })();
</script>
<style>
  .thanks-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: 60px 0;
  }
  h1 { font-size: 40px; font-weight: 500; }
  .thanks-inner p { margin: 0; font-size: 17px; line-height: 1.7; color: var(--muted); }
  .thanks-inner .btn { margin-top: 12px; }
  @media (max-width: 768px) {
    h1 { font-size: 30px; }
  }
</style>
