---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Bedankt — MonkAi Business" description="Bedankt voor je bericht. Ik antwoord binnen twee werkdagen." noindex={true}>
  <Nav />
  <main class="section thanks">
    <div class="container thanks-inner">
      <h1>Bedankt voor je bericht</h1>
      <p>Ik antwoord binnen twee werkdagen.</p>
      <a href="/" class="btn">Terug naar de homepage</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
<script is:inline>
  // Primaire conversie: het contactformulier is verstuurd (Netlify leidt hierheen door).
  // De PostHog-stub is synchroon beschikbaar; het event wordt gequeued tot de lib geladen is.
  window.posthog?.capture('contact_submitted');
</script>
<style>
  .thanks-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: 60px 0;
  }
  h1 { font-size: 40px; font-weight: 500; }
  .thanks-inner p { margin: 0; font-size: 17px; line-height: 1.7; color: var(--muted); }
  .thanks-inner .btn { margin-top: 12px; }
  @media (max-width: 768px) {
    h1 { font-size: 30px; }
  }
</style>
