---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Astro bouwt hier dist/404.html van; Netlify serveert dat bestand vanzelf bij
// elk pad dat niet bestaat. Geen configuratie nodig in netlify.toml.
---
<BaseLayout
  title="Pagina niet gevonden - MonkAi Business"
  description="Deze pagina bestaat niet of niet meer."
  noindex={true}
>
  <Nav />
  <main class="section notfound">
    <div class="container nf-inner">
      <!-- Het aapje uit het logo, groter en met een hand in zijn haar. Inline en
           niet als los .svg-bestand, want zo erft het de tokens uit tokens.css en
           draait het mee met dark mode (een <img>-SVG kan die variabelen niet lezen). -->
      <svg class="nf-monkey" viewBox="0 0 262 218" role="img" aria-label="Aapje dat in zijn haar krabt">
        <!-- vraagtekens -->
        <text x="0" y="92" class="nf-q nf-q-big">?</text>
        <text x="30" y="52" class="nf-q nf-q-small">?</text>

        <!-- krabstreepjes boven de hand -->
        <path d="M 120 20 Q 142 2 166 16" class="nf-scratch"></path>
        <path d="M 126 30 Q 142 20 158 28" class="nf-scratch"></path>

        <!-- romp met afhangende schouders, onderaan recht afgesneden -->
        <path d="M 66 210 C 70 174, 88 146, 124 146 C 160 146, 178 174, 182 210 Z" class="nf-face"></path>

        <!-- Oren, dan het groen, dan pas de kop: die dekt de binnenkant van het
             groen af zodat er een sikkel overblijft in plaats van een volle stip. -->
        <circle cx="51" cy="104" r="28" class="nf-face"></circle>
        <circle cx="197" cy="104" r="28" class="nf-face"></circle>
        <circle cx="64" cy="104" r="11.5" class="nf-accent"></circle>
        <circle cx="184" cy="104" r="11.5" class="nf-accent"></circle>

        <circle cx="124" cy="100" r="60" class="nf-face"></circle>

        <!-- Het gezicht is één doorlopend vlak met een zachte punt tussen de ogen,
             niet drie losse uitsparingen zoals in het logo. -->
        <path
          d="M 80 94
             C 80 72, 88 58, 100 58
             C 111 58, 118 66, 124 76
             C 130 66, 137 58, 148 58
             C 160 58, 168 72, 168 94
             C 168 116, 164 136, 154 145
             C 145 151, 135 154, 124 154
             C 113 154, 103 151, 94 145
             C 84 136, 80 116, 80 94 Z"
          class="nf-cutout"
        ></path>

        <circle cx="98" cy="86" r="11" class="nf-face"></circle>
        <circle cx="150" cy="86" r="11" class="nf-face"></circle>
        <circle cx="118.5" cy="117" r="5" class="nf-face"></circle>
        <circle cx="129.5" cy="117" r="5" class="nf-face"></circle>

        <!-- twijfelmondje: geen glimlach, een golfje -->
        <path d="M 106 136 q 9 -8 18 0 t 18 0" class="nf-mouth"></path>

        <!-- Hand op de kop. De twee bovenste vingers krijgen eerst dezelfde lijn in
             de paginakleur eronder; dat zijn de spleten ertussen. Zonder die
             contour valt de hele hand samen met de kop tot één donkere vlek. De
             onderste vinger krijgt er geen: die mag in de kop oplossen. -->
        <path d="M 153 38 L 206 33" class="nf-finger-key"></path>
        <path d="M 154 52 L 206 47" class="nf-finger-key"></path>

        <path d="M 153 38 L 206 33" class="nf-finger"></path>
        <path d="M 154 52 L 206 47" class="nf-finger"></path>
        <path d="M 163 66 L 206 61" class="nf-finger"></path>
        <circle cx="212" cy="47" r="16" class="nf-face"></circle>

        <!-- De arm gaat ruim buiten het oor om, anders wordt kop plus arm één
             donkere klomp. Hij komt ná de hand, anders knipt de contour van de
             vingers een lichte hap uit de arm. -->
        <path d="M 172 182 C 208 172, 238 152, 245 118 C 248 92, 232 66, 218 56" class="nf-limb"></path>
      </svg>

      <p class="eyebrow nf-code">Fout 404</p>
      <h1>Hier is iets foutgelopen</h1>
      <p class="nf-lead">
        Deze pagina bestaat niet, of niet meer. Waarschijnlijk klopt het adres niet
        helemaal of is de link waarop je klikte verouderd.
      </p>
      <a href="/" class="btn">Terug naar de homepage</a>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .nf-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    padding: 40px 0 60px;
  }
  .nf-monkey {
    width: 280px;
    max-width: 100%;
    height: auto;
    margin-bottom: 8px;
  }
  .nf-face { fill: var(--ink); }
  .nf-cutout { fill: var(--bg-page); }
  .nf-accent { fill: var(--green); }
  .nf-limb {
    fill: none;
    stroke: var(--ink);
    stroke-width: 23;
    stroke-linecap: round;
  }
  .nf-finger {
    fill: none;
    stroke: var(--ink);
    stroke-width: 10;
    stroke-linecap: round;
  }
  .nf-finger-key {
    fill: none;
    stroke: var(--bg-page);
    stroke-width: 15;
    stroke-linecap: round;
  }
  .nf-mouth {
    fill: none;
    stroke: var(--ink);
    stroke-width: 4.5;
    stroke-linecap: round;
  }
  .nf-scratch {
    fill: none;
    stroke: var(--green);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .nf-q {
    fill: var(--green);
    font-family: var(--font-serif);
    font-weight: 600;
  }
  .nf-q-big { font-size: 40px; }
  .nf-q-small { font-size: 26px; opacity: 0.75; }

  .nf-code { margin: 0; }
  h1 {
    font-size: 40px;
    font-weight: 500;
    margin: 0;
  }
  .nf-lead {
    margin: 0;
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted);
  }
  .nf-inner .btn { margin-top: 14px; }

  @media (max-width: 768px) {
    .nf-monkey { width: 210px; }
    h1 { font-size: 30px; }
  }
</style>
