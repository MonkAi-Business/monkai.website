---
const {
  title,
  description = "AI-adoptiecoaching voor Vlaamse KMO's door Stijn De Ketelaere. Rustig starten met AI, Claude-sessies en kennisstructuur, in heel Oost- en West-Vlaanderen.",
  image = '/og-image.png',
  noindex = false,
  schema = [],
} = Astro.props;

import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import BackToTop from '../components/BackToTop.astro';
import {
  THEMES,
  DEFAULT_THEME,
  MOBILE_FALLBACK_THEME,
  MOBILE_DEFAULT_THEME,
  NO_JS_THEME,
  STORAGE_KEY,
} from '../utils/theme';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

// Sitewide structured data: het bedrijf + Stijn als persoon (entiteiten die
// alle doelwoorden en het werkgebied aan elkaar knopen voor Google en AI-engines).
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': 'https://monkai.business/#business',
      name: 'MonkAi Business',
      description:
        "AI-adoptiecoaching voor Vlaamse KMO's, geleverd door Stijn De Ketelaere. Rustig en veilig starten met AI, Claude-sessies en kennisstructuur.",
      url: 'https://monkai.business/',
      image: 'https://monkai.business/og-image.png',
      email: 'stijn@monkai.business',
      priceRange: '€€',
      founder: { '@id': 'https://monkai.business/#stijn' },
      parentOrganization: {
        '@type': 'Organization',
        name: 'SDK Solutions BV',
        vatID: 'BE1027019469',
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Robert De Preesterstraat 55',
        postalCode: '9700',
        addressLocality: 'Oudenaarde',
        addressRegion: 'Oost-Vlaanderen',
        addressCountry: 'BE',
      },
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Oost-Vlaanderen' },
        { '@type': 'AdministrativeArea', name: 'West-Vlaanderen' },
        { '@type': 'City', name: 'Gent' },
        { '@type': 'Place', name: 'Vlaamse Ardennen' },
        { '@type': 'Place', name: 'Vlaanderen' },
      ],
      knowsAbout: [
        'AI-adoptie',
        'Claude-sessies',
        'Second brain',
        'Collective brain',
        'AI-governance',
        'EU AI Act',
        'Microsoft 365 Copilot',
      ],
      knowsLanguage: 'nl-BE',
    },
    {
      '@type': 'Person',
      '@id': 'https://monkai.business/#stijn',
      name: 'Stijn De Ketelaere',
      jobTitle: 'AI-adoptiecoach',
      description:
        "Stijn De Ketelaere is AI-adoptiecoach voor KMO's in Vlaanderen. Hij begeleidt bedrijven bij AI-adoptie, Claude-sessies en het opzetten van een second brain en collective brain.",
      url: 'https://monkai.business/#over',
      sameAs: ['https://www.linkedin.com/in/stijndeketelaere/'],
      worksFor: { '@id': 'https://monkai.business/#business' },
      affiliation: { '@id': 'https://pinpointinspections.eu/#organization' },
      knowsAbout: [
        'AI-adoptie',
        'Claude-sessies',
        'Second brain',
        'Collective brain',
        'AI-governance',
        'EU AI Act',
      ],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Oudenaarde',
        addressRegion: 'Oost-Vlaanderen',
        addressCountry: 'BE',
      },
    },
    {
      '@type': 'Organization',
      '@id': 'https://pinpointinspections.eu/#organization',
      name: 'PinPoint Inspections',
      description:
        'Digitale inspectiesoftware voor asset management, HSE-inspecties, 5S-audits en werfinspecties.',
      url: 'https://pinpointinspections.eu/',
      founder: { '@id': 'https://monkai.business/#stijn' },
    },
  ],
};

const schemas = [siteSchema, ...(Array.isArray(schema) ? schema : [schema])];
---
<!DOCTYPE html>
<html lang="nl" data-theme={NO_JS_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Zet het thema vóór de eerste verf. Zonder dit ziet wie donker koos eerst
         een lichte pagina en dan een sprong. Moet inline en blokkerend, dus dit
         script kan niet importeren; de waarden komen via define:vars uit
         src/utils/theme.ts. -->
    <script is:inline define:vars={{
      themes: THEMES,
      key: STORAGE_KEY,
      fallback: DEFAULT_THEME,
      mobileFallback: MOBILE_FALLBACK_THEME,
      mobileDefault: MOBILE_DEFAULT_THEME,
    }}>
      (function () {
        var chosen = null;
        try {
          // ?theme= in de URL wint en wordt bewaard. Dat is de achterdeur waarmee
          // een stand te bekijken is waarvan de knop nog niet rendert.
          var fromUrl = new URLSearchParams(window.location.search).get('theme');
          if (fromUrl && themes.indexOf(fromUrl) !== -1) {
            chosen = fromUrl;
            window.localStorage.setItem(key, fromUrl);
          }
          if (!chosen) {
            var stored = window.localStorage.getItem(key);
            if (stored && themes.indexOf(stored) !== -1) chosen = stored;
          }
        } catch (e) {
          // localStorage gooit in sommige privacystanden. Dan gewoon de standaard.
        }
        // Onthouden of dit een echte keuze is. De standaard is Monkey, en die
        // mag op een smal scherm niet als keuze bewaard worden: anders zit
        // iemand die één keer op zijn gsm langskwam ook op zijn laptop vast.
        var explicit = chosen !== null;
        chosen = chosen || fallback;
        if (chosen === 'monkey' && window.matchMedia('(max-width: 768px)').matches) {
          chosen = explicit ? mobileFallback : mobileDefault;
          if (explicit) {
            try {
              window.localStorage.setItem(key, chosen);
            } catch (e) {
              // Het gekozen thema geldt nog steeds voor deze pagina.
            }
          }
        }
        document.documentElement.setAttribute('data-theme', chosen);
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MonkAi Business" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Work+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <Analytics />
  </head>
  <body>
    <slot />
    <ConsentBanner />
    <!-- Na ConsentBanner, want BackToTop verbergt zichzelf op mobiel zolang die
         banner er staat en gebruikt daarvoor de zustercombinator. -->
    <BackToTop />
  </body>
</html>
