      data-chapter="niveaus"
      data-panel-side="right"
      data-panel-vertical="middle"
      data-panel-size="compact"
      data-time-start={chapters[5].timeStart}
      data-time-end={chapters[5].timeEnd}
      data-footage={chapters[5].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">Eén groeipad</p>
        <h2>Drie niveaus. Eén tempo.</h2>
        <div class="monkey-levels">
          {ladderLevels.map((level, index) => (
            <article>
              <span>0{index + 1}</span>
              <div>
                <h3>{level.title}</h3>
                <p>{level.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-use-cases"
      data-monkey-chapter
      data-chapter="use-cases"
      data-panel-side="left"
      data-panel-vertical="bottom"
      data-panel-size="compact"
      data-time-start={chapters[6].timeStart}
      data-time-end={chapters[6].timeEnd}
      data-footage={chapters[6].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">Uit de praktijk</p>
        <h2>Van idee naar werkende oplossing</h2>
        <div class="monkey-link-grid">
          {useCases.map((item) => (
            <a href={`/use-cases/${item.id}`}>
              <span>{pad(item.data.order)}</span>
              <div>
                <h3>{item.data.title}</h3>
                <p>{item.data.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-diensten"
      data-monkey-chapter
      data-chapter="diensten"
      data-panel-side="left"
      data-panel-vertical="middle"
      data-panel-size="wide"
      data-time-start={chapters[7].timeStart}
      data-time-end={chapters[7].timeEnd}
      data-footage={chapters[7].footage}
    >
      <div class="monkey-panel monkey-panel-services">
        <p class="monkey-kicker">Diensten</p>
        <h2>Wat we voor je doen</h2>
        <div class="monkey-service-grid">
          {services.map((service) => (
            <article class:list={{ featured: service.featured }}>
              {service.eyebrow && <span>{service.eyebrow}</span>}
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-breder-dan-chat"
      data-monkey-chapter
      data-chapter="breder-dan-chat"
      data-panel-side="right"
      data-panel-vertical="bottom"
      data-panel-size="compact"
      data-time-start={chapters[8].timeStart}
      data-time-end={chapters[8].timeEnd}
      data-footage={chapters[8].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">Verder dan generatieve AI</p>
        <h2>AI is meer dan een chatbot</h2>
        <p>Waar het past kijken we ook naar wat er op de werkvloer zelf kan.</p>
        <div class="monkey-rows">
          {beyondChatRows.map((row) => (
            <div>
              <strong>{row.title}</strong>
              <span>{row.text}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-ai-act"
      data-monkey-chapter
      data-chapter="ai-act"
      data-panel-side="left"
      data-panel-vertical="bottom"
      data-panel-size="compact"
      data-time-start={chapters[9].timeStart}
      data-time-end={chapters[9].timeEnd}
      data-footage={chapters[9].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">AI-geletterdheid en EU AI Act</p>
        <h2>AI Act klaar, zonder rem op innovatie</h2>
        <p>Wie met AI werkt, moet AI voldoende begrijpen. Ik breng in kaart waar je team staat en bouw de geletterdheid stap voor stap op, aangepast aan elke rol.</p>
        <ul class="monkey-checks">
          <li>Duidelijke afspraken over data en tools</li>
          <li>Verantwoordelijkheid per rol</li>
          <li>Veilig experimenteren in gewone taal</li>
        </ul>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-afspraak"
      data-monkey-chapter
      data-chapter="afspraak"
      data-panel-side="left"
      data-panel-vertical="top"
      data-panel-size="compact"
      data-time-start={chapters[10].timeStart}
      data-time-end={chapters[10].timeEnd}
      data-footage={chapters[10].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">Samenwerken</p>
        <h2>Een heldere afspraak</h2>
        <div class="monkey-agreement">
          <article>
            <h3>Wat ik breng</h3>
            <ul>
              {agreement.monkai.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article>
            <h3>Wat jij brengt</h3>
            <ul>
              {agreement.customer.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-blog"
      data-monkey-chapter
      data-chapter="blog"
      data-panel-side="left"
      data-panel-vertical="bottom"
      data-panel-size="compact"
      data-time-start={chapters[11].timeStart}
      data-time-end={chapters[11].timeEnd}
      data-footage={chapters[11].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">Uit de blog</p>
        <h2>Praktische AI-inzichten</h2>
        <div class="monkey-posts">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`}>
              <span>{formatDate(post.data.date)}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
        <a class="monkey-link" href="/blog">Bekijk alle artikels</a>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-faq"
      data-monkey-chapter
      data-chapter="faq"
      data-panel-side="left"
      data-panel-vertical="top"
      data-panel-size="compact"
      data-time-start={chapters[12].timeStart}
      data-time-end={chapters[12].timeEnd}
      data-footage={chapters[12].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">Kort en nuchter</p>
        <h2>Veelgestelde vragen</h2>
        <FaqList compact={true} />
      </div>
    </section>

    <section
      class="monkey-chapter monkey-chapter-contact"
      id="monkey-contact"
      data-monkey-chapter
      data-chapter="contact"
      data-panel-side="left"
      data-panel-vertical="middle"
      data-panel-size="compact"
      data-time-start={chapters[13].timeStart}
      data-time-end={chapters[13].timeEnd}
      data-footage={chapters[13].footage}
    >
      <div class="monkey-panel monkey-panel-contact">
        <div>
          <p class="monkey-kicker">Contact</p>
          <h2>Klaar om iets slim te bouwen?</h2>
          <p>Geen verkooppraatje en geen verplichtingen. We bekijken waar de monkey business bij jou zit.</p>
        </div>
        <ContactForm compact={true} idPrefix="monkey" />
      </div>
    </section>
  </div>
</section>

<script>
  import {
    autoplayPlaybackRate,
    autoplayButtonState,
    isAutoplayScrollKey,
    resolveAutoScrollStart,
  } from '../utils/scrollStoryAutoplay.mjs';
  import {
    progressToTime,
    timeToProgress,
  } from '../utils/scrollStoryTiming.mjs';
  import {
    initialBufferedEnd,
    bufferStatus,
  } from '../utils/scrollStoryBuffer.mjs';

  type StoryWindow = Window & {
    scrollToMonkeyChapter?: (id: string) => void;
  };

  type ChapterTiming = {
    timeStart: number;
    timeEnd: number;
  };

  const story = document.querySelector<HTMLElement>('[data-scroll-story]');
  const desktop = window.matchMedia('(min-width: 769px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (story) {
    const video = story.querySelector<HTMLVideoElement>('[data-story-video]');
    const autoplayButton = story.querySelector<HTMLButtonElement>('[data-story-autoplay]');
    const loader = story.querySelector<HTMLElement>('[data-story-loader]');
    const loaderLabel = story.querySelector<HTMLElement>('[data-story-loader-label]');
    const loaderValue = story.querySelector<HTMLElement>('[data-story-loader-value]');
    const contactChapter = story.querySelector<HTMLElement>('[data-chapter="contact"]');
    const sources = Array.from(
      story.querySelectorAll<HTMLSourceElement>('source[data-src]'),
    );
    const chapterElements = Array.from(
      story.querySelectorAll<HTMLElement>('[data-monkey-chapter]'),
    );
    const timings: ChapterTiming[] = chapterElements.map((chapter) => ({
      timeStart: Number(chapter.dataset.timeStart ?? 0),
      timeEnd: Number(chapter.dataset.timeEnd ?? 0),
    }));

    let targetTime = 0;
    let renderedTime = 0;
    let duration = 58.08;
    let animationFrame = 0;
    let lastSeek = 0;
    let storyVisible = false;
    let autoplayFrame = 0;
    let autoplayPlaying = false;
    let bufferReady = false;
    let bufferFailed = false;

    const clamp = (value: number, minimum: number, maximum: number) =>
      Math.min(Math.max(value, minimum), maximum);

    const isMonkey = () =>
      document.documentElement.dataset.theme === 'monkey' && desktop.matches;

    const canScrub = () => isMonkey() && !reducedMotion.matches;

    function syncAutoplayButton() {
      if (!autoplayButton) return;
      const state = autoplayButtonState(autoplayPlaying);
      const ready = bufferReady && !bufferFailed;
      autoplayButton.dataset.playing = state.playing;
      autoplayButton.setAttribute('aria-pressed', state.ariaPressed);
      autoplayButton.setAttribute('aria-label', state.ariaLabel);
      autoplayButton.disabled = !ready;
      autoplayButton.setAttribute('aria-disabled', String(!ready));
    }

    function updateBufferState() {
      if (!video || bufferFailed || !isMonkey()) return;
      const status = bufferStatus({
        duration: video.duration,
        bufferedUntil: initialBufferedEnd(video.buffered),
        readyState: video.readyState,
        requiredSeconds: 8,
      });

      story.style.setProperty('--buffer-progress', String(status.progress));
      if (loaderValue) loaderValue.textContent = `${status.progress}%`;

      if (status.ready && !bufferReady) {
        bufferReady = true;
        if (!autoplayPlaying && Number.isFinite(targetTime)) {
          video.currentTime = clamp(targetTime, 0, Math.max(duration - 0.04, 0));
        }
      }

      if (bufferReady) {
        story.dataset.bufferState = 'ready';
        if (loader) loader.setAttribute('aria-hidden', 'true');
      } else {
        story.dataset.bufferState = 'loading';
        if (loader) loader.setAttribute('aria-hidden', 'false');
      }

      syncAutoplayButton();
    }

    function showBufferError() {
      bufferFailed = true;
      bufferReady = false;
      story.dataset.bufferState = 'error';
      if (loader) loader.setAttribute('aria-hidden', 'false');
      if (loaderLabel) loaderLabel.textContent = 'Video kon niet laden';
      if (loaderValue) loaderValue.textContent = '';
      stopAutoplay();
      syncAutoplayButton();
    }

    function stopAutoplay() {
      if (autoplayFrame) window.cancelAnimationFrame(autoplayFrame);
      autoplayFrame = 0;
      if (video) {
        video.pause();
        if (Number.isFinite(video.currentTime)) {
          targetTime = video.currentTime;
          renderedTime = video.currentTime;
        }
      }
      autoplayPlaying = false;
      syncAutoplayButton();
    }

    function autoplayBounds() {
      if (!contactChapter) return null;
      const storyTop = window.scrollY + story.getBoundingClientRect().top;
      const contactTop = window.scrollY + contactChapter.getBoundingClientRect().top;
      return {
        start: storyTop,
        end: contactTop,
        chapterCount: Math.max(chapterElements.length - 1, 0),
      };
    }

    function autoplayTick(timestamp: number) {
      if (!autoplayPlaying || !canScrub() || document.hidden) {
        stopAutoplay();
        return;
      }

      const bounds = autoplayBounds();
      if (!bounds || bounds.end <= bounds.start) {
        stopAutoplay();
        return;
      }

      const progress = timeToProgress(video.currentTime, timings);
      const position = bounds.start + (bounds.end - bounds.start) * progress;
      window.scrollTo({ top: position, behavior: 'auto' });

      if (video.ended || video.currentTime >= duration - 0.05) {
        window.scrollTo({ top: bounds.end, behavior: 'auto' });
        stopAutoplay();
        return;
      }

      autoplayFrame = window.requestAnimationFrame(autoplayTick);
    }

    function startAutoplay() {
      if (!canScrub() || !video || !bufferReady || bufferFailed) return;
      const bounds = autoplayBounds();
      if (!bounds || bounds.end <= bounds.start) return;

      const startPosition = resolveAutoScrollStart(
        window.scrollY,
        bounds.start,
        bounds.end,
      );
      window.scrollTo({ top: startPosition, behavior: 'auto' });
      const progress = (startPosition - bounds.start) / (bounds.end - bounds.start);
      targetTime = progressToTime(progress, timings);
      renderedTime = targetTime;
      autoplayPlaying = true;
      syncAutoplayButton();

      const beginPlayback = () => {
        if (!autoplayPlaying) return;
        duration = Number.isFinite(video.duration) ? video.duration : duration;
        video.currentTime = clamp(targetTime, 0, Math.max(duration - 0.04, 0));
        video.playbackRate = autoplayPlaybackRate(
          duration,
          bounds.chapterCount,
        );
        video.play()
          .then(() => {
            if (autoplayPlaying && !autoplayFrame) {
              autoplayFrame = window.requestAnimationFrame(autoplayTick);
            }
          })
          .catch(stopAutoplay);
      };

      if (video.readyState >= HTMLMediaElement.HAVE_METADATA) {
        beginPlayback();
      } else {
        video.addEventListener('loadedmetadata', beginPlayback, { once: true });
        loadVideo();
      }
    }

    function toggleAutoplay() {
      if (autoplayPlaying) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    }

    function setActiveChapter(activeChapter: HTMLElement) {
      story.dataset.activePanelSide = activeChapter.dataset.panelSide ?? 'left';
      chapterElements.forEach((chapter) => {
        const active = chapter === activeChapter;
        chapter.dataset.active = String(active);
        chapter.inert = !active;
        if (active) {
          chapter.setAttribute('aria-current', 'step');
        } else {
          chapter.removeAttribute('aria-current');
        }
      });
    }

    function showStaticChapters() {
      chapterElements.forEach((chapter) => {
        chapter.dataset.active = 'true';
        chapter.inert = false;
        chapter.removeAttribute('aria-current');
      });
    }

    function loadVideo() {
      if (!video) return;
      bufferFailed = false;
      bufferReady = false;
      story.dataset.bufferState = 'loading';
      video.preload = 'auto';
      if (loader) loader.setAttribute('aria-hidden', 'false');
      if (loaderLabel) loaderLabel.textContent = 'Junglefilm laden';
      if (loaderValue) loaderValue.textContent = '0%';
      story.style.setProperty('--buffer-progress', '0');
      syncAutoplayButton();
      sources.forEach((source) => {
        if (!source.src && source.dataset.src) {
          source.src = source.dataset.src;
        }
      });
      video.load();
    }

    function releaseVideo() {
      if (!video) return;
      video.pause();
      video.preload = 'none';
      sources.forEach((source) => source.removeAttribute('src'));
      video.removeAttribute('src');
      video.load();
      bufferReady = false;
      bufferFailed = false;
      story.dataset.bufferState = 'idle';
      if (loader) loader.setAttribute('aria-hidden', 'true');
      syncAutoplayButton();
    }

    function stopRendering() {
      if (animationFrame) {
        window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      }
    }

    function updateTarget() {
      if (!canScrub()) return;
      const scrollableDistance = story.offsetHeight - window.innerHeight;
      const top = story.getBoundingClientRect().top;
      const progress = scrollableDistance > 0
        ? clamp(-top / scrollableDistance, 0, 1)
        : 0;

      targetTime = progressToTime(progress, timings);
      story.style.setProperty('--story-progress', String(progress));
    }

    function render(time: number) {
      if (!canScrub() || !storyVisible || !video) {
        animationFrame = 0;
        return;
      }

      const difference = targetTime - renderedTime;
      renderedTime = Math.abs(difference) > 6
        ? targetTime
        : renderedTime + difference * 0.2;

      if (
        !autoplayPlaying
        && video.readyState >= HTMLMediaElement.HAVE_METADATA
        && time - lastSeek > 42
        && Math.abs(video.currentTime - renderedTime) > 0.015
        && !video.seeking
      ) {
        video.currentTime = clamp(renderedTime, 0, Math.max(duration - 0.04, 0));
        lastSeek = time;
      }

      animationFrame = window.requestAnimationFrame(render);
    }

    function startRendering() {
      if (canScrub() && storyVisible && !animationFrame) {
        animationFrame = window.requestAnimationFrame(render);
      }
    }

    function syncMode() {
      if (!canScrub()) stopAutoplay();

      if (isMonkey() && reducedMotion.matches) {
        story.dataset.reduced = 'true';
        releaseVideo();
        stopRendering();
        showStaticChapters();
        return;
      }

      delete story.dataset.reduced;

      if (canScrub()) {
        loadVideo();
        setActiveChapter(chapterElements[0]);
        updateTarget();
        startRendering();
      } else {
        releaseVideo();
        stopRendering();
      }
    }

    story.dataset.enhanced = 'true';
    setActiveChapter(chapterElements[0]);

    video?.addEventListener('loadedmetadata', () => {
      duration = Number.isFinite(video.duration) ? video.duration : duration;
      updateBufferState();
      updateTarget();
      renderedTime = targetTime;
      if (!autoplayPlaying) {
        video.currentTime = bufferReady
          ? clamp(targetTime, 0, Math.max(duration - 0.04, 0))
          : 0;
      }
      startRendering();
    });
    video?.addEventListener('progress', updateBufferState);
    video?.addEventListener('canplay', updateBufferState);
    video?.addEventListener('canplaythrough', updateBufferState);
    video?.addEventListener('error', showBufferError);

    const chapterObserver = new IntersectionObserver((entries) => {
      if (reducedMotion.matches) return;
      const activeEntry = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (activeEntry) setActiveChapter(activeEntry.target as HTMLElement);
    }, {
      rootMargin: '-42% 0px -42% 0px',
      threshold: [0, 0.25, 0.5, 0.75, 1],
    });

    chapterElements.forEach((chapter) => chapterObserver.observe(chapter));

    const visibilityObserver = new IntersectionObserver((entries) => {
      storyVisible = entries[0]?.isIntersecting ?? false;
      if (storyVisible) {
        updateTarget();
        startRendering();
      } else {
        stopRendering();
      }
    });
    visibilityObserver.observe(story);

    (window as StoryWindow).scrollToMonkeyChapter = (id: string) => {
      story.querySelector<HTMLElement>(`[data-chapter="${id}"]`)
        ?.scrollIntoView({
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
          block: 'start',
        });
    };

    autoplayButton?.addEventListener('click', toggleAutoplay);
    window.addEventListener('wheel', stopAutoplay, { passive: true });
    window.addEventListener('touchstart', stopAutoplay, { passive: true });
    window.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !autoplayButton?.contains(event.target)) {
        stopAutoplay();
      }
    }, { passive: true });
    window.addEventListener('keydown', (event) => {
      if (isAutoplayScrollKey(event.key)) stopAutoplay();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAutoplay();
    });
    window.addEventListener('scroll', () => {
      updateTarget();
      startRendering();
    }, { passive: true });
    window.addEventListener('resize', updateTarget, { passive: true });
    window.addEventListener('pageshow', updateTarget);
    window.addEventListener('monkai-theme-change', syncMode);
    desktop.addEventListener('change', syncMode);
    reducedMotion.addEventListener('change', syncMode);
    syncAutoplayButton();
    syncMode();
  }
</script>

