---
import { getCollection } from 'astro:content';
import {
  agreement,
  approachSteps,
  beyondChatRows,
  ladderLevels,
  problemCards,
  services,
} from '../data/home';
import ContactForm from './ContactForm.astro';
import FaqList from './FaqList.astro';

const useCases = (await getCollection('usecases', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) => new Intl.DateTimeFormat('nl-BE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);

const pad = (value: number) => String(value).padStart(2, '0');

const chapters = [
  { id: 'hero', timeStart: 0, timeEnd: 7.82, footage: 'ready' },
  { id: 'problemen', timeStart: 7.82, timeEnd: 15.64, footage: 'ready' },
  { id: 'overdracht', timeStart: 15.64, timeEnd: 32.98, footage: 'ready' },
  { id: 'team', timeStart: 32.98, timeEnd: 50.04, footage: 'ready' },
  { id: 'aanpak', timeStart: 50.04, timeEnd: 58.04, footage: 'ready' },
  { id: 'niveaus', timeStart: 58.04, timeEnd: 58.04, footage: 'pending' },
  { id: 'use-cases', timeStart: 58.04, timeEnd: 58.04, footage: 'pending' },
  { id: 'diensten', timeStart: 58.04, timeEnd: 58.04, footage: 'pending' },
  { id: 'breder-dan-chat', timeStart: 58.04, timeEnd: 58.04, footage: 'pending' },
  { id: 'ai-act', timeStart: 58.04, timeEnd: 58.04, footage: 'pending' },
  { id: 'afspraak', timeStart: 58.04, timeEnd: 58.04, footage: 'pending' },
  { id: 'blog', timeStart: 58.04, timeEnd: 58.04, footage: 'pending' },
  { id: 'faq', timeStart: 58.04, timeEnd: 58.04, footage: 'pending' },
  { id: 'contact', timeStart: 58.04, timeEnd: 58.04, footage: 'pending' },
] as const;
---

<section class="monkey-story" data-scroll-story>
  <div class="monkey-stage">
    <video
      class="monkey-video"
      muted
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      data-story-video
    >
      <source data-src="/media/scroll-story/monkai-scroll-story.webm" type="video/webm" />
      <source data-src="/media/scroll-story/monkai-scroll-story.mp4" type="video/mp4" />
    </video>
    <div class="monkey-shade" aria-hidden="true"></div>
    <div class="monkey-progress" aria-hidden="true">
      <span>Monkey mode</span>
      <span class="monkey-progress-track"><span></span></span>
    </div>
  </div>

  <div class="monkey-chapters">
    <section
      class="monkey-chapter monkey-chapter-hero"
      id="monkey-hero"
      data-monkey-chapter
      data-chapter="hero"
      data-time-start={chapters[0].timeStart}
      data-time-end={chapters[0].timeEnd}
      data-footage={chapters[0].footage}
    >
      <div class="monkey-panel monkey-panel-wide">
        <p class="monkey-kicker">MonkAi Business</p>
        <h1>AI zonder apenstreken<span aria-hidden="true">.</span></h1>
        <p class="monkey-lede">Ik help Vlaamse KMO's rustig en veilig starten met AI. Klein beginnen, herhalen, beheersen.</p>
        <div class="monkey-actions">
          <a class="btn" href="#monkey-contact">Laten we praten</a>
          <a class="monkey-link" href="#monkey-aanpak">Bekijk de aanpak</a>
        </div>
        <div class="monkey-meta">
          <span>Inspiratiesessie</span>
          <span>Sparring in kleine groepen</span>
          <span>Bij jou op locatie</span>
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter monkey-chapter-right"
      id="monkey-problemen"
      data-monkey-chapter
      data-chapter="problemen"
      data-time-start={chapters[1].timeStart}
      data-time-end={chapters[1].timeEnd}
      data-footage={chapters[1].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">Het vertrekpunt</p>
        <h2>Van losse experimenten naar echte impact</h2>
        <div class="monkey-card-list">
          {problemCards.map((card) => (
            <article>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-overdracht"
      data-monkey-chapter
      data-chapter="overdracht"
      data-time-start={chapters[2].timeStart}
      data-time-end={chapters[2].timeEnd}
      data-footage={chapters[2].footage}
    >
      <div class="monkey-panel monkey-panel-quote">
        <p class="monkey-kicker">De afspraak vanaf dag één</p>
        <h2>Werk slimmer. Niet afhankelijker.</h2>
        <blockquote>Mijn doel is dat je mij niet meer nodig hebt.</blockquote>
        <p>Ik geef een kickstart, draag over en blijf niet plakken.</p>
      </div>
    </section>

    <section
      class="monkey-chapter monkey-chapter-right"
      id="monkey-team"
      data-monkey-chapter
      data-chapter="team"
      data-time-start={chapters[3].timeStart}
      data-time-end={chapters[3].timeEnd}
      data-footage={chapters[3].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">Het team</p>
        <h2>Klein team. Korte lijnen.</h2>
        <div class="monkey-person">
          <img src="/media/stijn.jpg" alt="Stijn De Ketelaere" width="88" height="88" loading="lazy" />
          <div>
            <h3>Stijn De Ketelaere</h3>
            <p>AI-adoptiecoach vanuit Oudenaarde, met technische ervaring en beide voeten in het Vlaamse KMO-landschap.</p>
          </div>
        </div>
        <p>Je werkt rechtstreeks met mij, van de eerste sessie tot de overdracht. Het team groeit met mensen die dezelfde nuchtere aanpak delen.</p>
        <a class="monkey-link" href="https://www.linkedin.com/in/stijndeketelaere/" target="_blank" rel="noopener">Volg Stijn op LinkedIn</a>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-aanpak"
      data-monkey-chapter
      data-chapter="aanpak"
      data-time-start={chapters[4].timeStart}
      data-time-end={chapters[4].timeEnd}
      data-footage={chapters[4].footage}
    >
      <div class="monkey-panel monkey-panel-wide">
        <p class="monkey-kicker">De aanpak</p>
        <h2>Zo pakken we het aan</h2>
        <div class="monkey-step-grid">
          {approachSteps.map((step) => (
            <article>
              <span>{step.num}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter monkey-chapter-right"
      id="monkey-niveaus"
      data-monkey-chapter
      data-chapter="niveaus"
      data-time-start={chapters[5].timeStart}
      data-time-end={chapters[5].timeEnd}
      data-footage={chapters[5].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">Eén groeipad</p>
        <h2>Drie niveaus. Eén tempo.</h2>
        <div class="monkey-levels">
          {ladderLevels.map((level, index) => (
            <article>
              <span>0{index + 1}</span>
              <div>
                <h3>{level.title}</h3>
                <p>{level.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-use-cases"
      data-monkey-chapter
      data-chapter="use-cases"
      data-time-start={chapters[6].timeStart}
      data-time-end={chapters[6].timeEnd}
      data-footage={chapters[6].footage}
    >
      <div class="monkey-panel monkey-panel-wide">
        <p class="monkey-kicker">Uit de praktijk</p>
        <h2>Van idee naar werkende oplossing</h2>
        <div class="monkey-link-grid">
          {useCases.map((item) => (
            <a href={`/use-cases/${item.id}`}>
              <span>{pad(item.data.order)}</span>
              <div>
                <h3>{item.data.title}</h3>
                <p>{item.data.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter monkey-chapter-right"
      id="monkey-diensten"
      data-monkey-chapter
      data-chapter="diensten"
      data-time-start={chapters[7].timeStart}
      data-time-end={chapters[7].timeEnd}
      data-footage={chapters[7].footage}
    >
      <div class="monkey-panel monkey-panel-wide">
        <p class="monkey-kicker">Diensten</p>
        <h2>Wat we voor je bouwen</h2>
        <div class="monkey-service-grid">
          {services.map((service) => (
            <article class:list={{ featured: service.featured }}>
              {service.eyebrow && <span>{service.eyebrow}</span>}
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-breder-dan-chat"
      data-monkey-chapter
      data-chapter="breder-dan-chat"
      data-time-start={chapters[8].timeStart}
      data-time-end={chapters[8].timeEnd}
      data-footage={chapters[8].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">Verder dan generatieve AI</p>
        <h2>AI is meer dan een chatbot</h2>
        <p>Waar het past kijken we ook naar wat er op de werkvloer zelf kan.</p>
        <div class="monkey-rows">
          {beyondChatRows.map((row) => (
            <div>
              <strong>{row.title}</strong>
              <span>{row.text}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter monkey-chapter-right"
      id="monkey-ai-act"
      data-monkey-chapter
      data-chapter="ai-act"
      data-time-start={chapters[9].timeStart}
      data-time-end={chapters[9].timeEnd}
      data-footage={chapters[9].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">AI-geletterdheid en EU AI Act</p>
        <h2>AI Act klaar, zonder rem op innovatie</h2>
        <p>Wie met AI werkt, moet AI voldoende begrijpen. Ik breng in kaart waar je team staat en bouw de geletterdheid stap voor stap op, aangepast aan elke rol.</p>
        <ul class="monkey-checks">
          <li>Duidelijke afspraken over data en tools</li>
          <li>Verantwoordelijkheid per rol</li>
          <li>Veilig experimenteren in gewone taal</li>
        </ul>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-afspraak"
      data-monkey-chapter
      data-chapter="afspraak"
      data-time-start={chapters[10].timeStart}
      data-time-end={chapters[10].timeEnd}
      data-footage={chapters[10].footage}
    >
      <div class="monkey-panel monkey-panel-wide">
        <p class="monkey-kicker">Samenwerken</p>
        <h2>Een heldere afspraak</h2>
        <div class="monkey-agreement">
          <article>
            <h3>Wat ik breng</h3>
            <ul>
              {agreement.monkai.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article>
            <h3>Wat jij brengt</h3>
            <ul>
              {agreement.customer.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter monkey-chapter-right"
      id="monkey-blog"
      data-monkey-chapter
      data-chapter="blog"
      data-time-start={chapters[11].timeStart}
      data-time-end={chapters[11].timeEnd}
      data-footage={chapters[11].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">Uit de blog</p>
        <h2>Praktische AI-inzichten</h2>
        <div class="monkey-posts">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`}>
              <span>{formatDate(post.data.date)}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
        <a class="monkey-link" href="/blog">Bekijk alle artikels</a>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-faq"
      data-monkey-chapter
      data-chapter="faq"
      data-time-start={chapters[12].timeStart}
      data-time-end={chapters[12].timeEnd}
      data-footage={chapters[12].footage}
    >
      <div class="monkey-panel monkey-panel-wide">
        <p class="monkey-kicker">Kort en nuchter</p>
        <h2>Veelgestelde vragen</h2>
        <FaqList compact={true} />
      </div>
    </section>

    <section
      class="monkey-chapter monkey-chapter-contact"
      id="monkey-contact"
      data-monkey-chapter
      data-chapter="contact"
      data-time-start={chapters[13].timeStart}
      data-time-end={chapters[13].timeEnd}
      data-footage={chapters[13].footage}
    >
      <div class="monkey-panel monkey-panel-contact">
        <div>
          <p class="monkey-kicker">Contact</p>
          <h2>Klaar om iets slim te bouwen?</h2>
          <p>Geen verkooppraatje en geen verplichtingen. We bekijken waar de monkey business bij jou zit.</p>
        </div>
        <ContactForm compact={true} idPrefix="monkey" />
      </div>
    </section>
  </div>
</section>

<script>
  type StoryWindow = Window & {
    scrollToMonkeyChapter?: (id: string) => void;
  };

  type ChapterTiming = {
    timeStart: number;
    timeEnd: number;
  };

  const story = document.querySelector<HTMLElement>('[data-scroll-story]');
  const desktop = window.matchMedia('(min-width: 769px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (story) {
    const video = story.querySelector<HTMLVideoElement>('[data-story-video]');
    const sources = Array.from(
      story.querySelectorAll<HTMLSourceElement>('source[data-src]'),
    );
    const chapterElements = Array.from(
      story.querySelectorAll<HTMLElement>('[data-monkey-chapter]'),
    );
    const timings: ChapterTiming[] = chapterElements.map((chapter) => ({
      timeStart: Number(chapter.dataset.timeStart ?? 0),
      timeEnd: Number(chapter.dataset.timeEnd ?? 0),
    }));

    let targetTime = 0;
    let renderedTime = 0;
    let duration = 58.08;
    let animationFrame = 0;
    let lastSeek = 0;
    let storyVisible = false;

    const clamp = (value: number, minimum: number, maximum: number) =>
      Math.min(Math.max(value, minimum), maximum);

    const isMonkey = () =>
      document.documentElement.dataset.theme === 'monkey' && desktop.matches;

    const canScrub = () => isMonkey() && !reducedMotion.matches;

    function progressToTime(progress: number, chapterTimings: readonly ChapterTiming[]) {
      const chapterPosition = Math.min(
        Math.max(progress, 0) * chapterTimings.length,
        chapterTimings.length - Number.EPSILON,
      );
      const chapterIndex = Math.min(
        Math.floor(chapterPosition),
        chapterTimings.length - 1,
      );
      const local = chapterPosition - chapterIndex;
      const move = local < 0.42 ? local / 0.42 : 1;
      const chapter = chapterTimings[chapterIndex];
      return chapter.timeStart + (chapter.timeEnd - chapter.timeStart) * move;
    }

    function setActiveChapter(activeChapter: HTMLElement) {
      chapterElements.forEach((chapter) => {
        const active = chapter === activeChapter;
        chapter.dataset.active = String(active);
        chapter.inert = !active;
        if (active) {
          chapter.setAttribute('aria-current', 'step');
        } else {
          chapter.removeAttribute('aria-current');
        }
      });
    }

    function showStaticChapters() {
      chapterElements.forEach((chapter) => {
        chapter.dataset.active = 'true';
        chapter.inert = false;
        chapter.removeAttribute('aria-current');
      });
    }

    function loadVideo() {
      if (!video) return;
      sources.forEach((source) => {
        if (!source.src && source.dataset.src) {
          source.src = source.dataset.src;
        }
      });
      video.load();
    }

    function releaseVideo() {
      if (!video) return;
      video.pause();
      sources.forEach((source) => source.removeAttribute('src'));
      video.removeAttribute('src');
      video.load();
    }

    function stopRendering() {
      if (animationFrame) {
        window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      }
    }

    function updateTarget() {
      if (!canScrub()) return;
      const scrollableDistance = story.offsetHeight - window.innerHeight;
      const top = story.getBoundingClientRect().top;
      const progress = scrollableDistance > 0
        ? clamp(-top / scrollableDistance, 0, 1)
        : 0;

      targetTime = progressToTime(progress, timings);
      story.style.setProperty('--story-progress', String(progress));
    }

    function render(time: number) {
      if (!canScrub() || !storyVisible || !video) {
        animationFrame = 0;
        return;
      }

      const difference = targetTime - renderedTime;
      renderedTime = Math.abs(difference) > 6
        ? targetTime
        : renderedTime + difference * 0.2;

      if (
        video.readyState >= HTMLMediaElement.HAVE_METADATA
        && time - lastSeek > 42
        && Math.abs(video.currentTime - renderedTime) > 0.015
        && !video.seeking
      ) {
        video.currentTime = clamp(renderedTime, 0, Math.max(duration - 0.04, 0));
        lastSeek = time;
      }

      animationFrame = window.requestAnimationFrame(render);
    }

    function startRendering() {
      if (canScrub() && storyVisible && !animationFrame) {
        animationFrame = window.requestAnimationFrame(render);
      }
    }

    function syncMode() {
      if (isMonkey() && reducedMotion.matches) {
        story.dataset.reduced = 'true';
        releaseVideo();
        stopRendering();
        showStaticChapters();
        return;
      }

      delete story.dataset.reduced;

      if (canScrub()) {
        loadVideo();
        setActiveChapter(chapterElements[0]);
        updateTarget();
        startRendering();
      } else {
        releaseVideo();
        stopRendering();
      }
    }

    story.dataset.enhanced = 'true';
    setActiveChapter(chapterElements[0]);

    video?.addEventListener('loadedmetadata', () => {
      duration = Number.isFinite(video.duration) ? video.duration : duration;
      updateTarget();
      renderedTime = targetTime;
      video.currentTime = clamp(targetTime, 0, Math.max(duration - 0.04, 0));
      startRendering();
    });

    const chapterObserver = new IntersectionObserver((entries) => {
      if (reducedMotion.matches) return;
      const activeEntry = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (activeEntry) setActiveChapter(activeEntry.target as HTMLElement);
    }, {
      rootMargin: '-42% 0px -42% 0px',
      threshold: [0, 0.25, 0.5, 0.75, 1],
    });

    chapterElements.forEach((chapter) => chapterObserver.observe(chapter));

    const visibilityObserver = new IntersectionObserver((entries) => {
      storyVisible = entries[0]?.isIntersecting ?? false;
      if (storyVisible) {
        updateTarget();
        startRendering();
      } else {
        stopRendering();
      }
    });
    visibilityObserver.observe(story);

    (window as StoryWindow).scrollToMonkeyChapter = (id: string) => {
      story.querySelector<HTMLElement>(`[data-chapter="${id}"]`)
        ?.scrollIntoView({
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
          block: 'start',
        });
    };

    window.addEventListener('scroll', () => {
      updateTarget();
      startRendering();
    }, { passive: true });
    window.addEventListener('resize', updateTarget, { passive: true });
    window.addEventListener('pageshow', updateTarget);
    window.addEventListener('monkai-theme-change', syncMode);
    desktop.addEventListener('change', syncMode);
    reducedMotion.addEventListener('change', syncMode);
    syncMode();
  }
</script>

<style>
  .monkey-story {
    --story-progress: 0;
    position: relative;
    background: #071218;
    color: #fff;
  }

  .monkey-stage {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100vh;
    min-height: 620px;
    margin-bottom: -100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 70% 30%, rgba(120, 166, 111, 0.18), transparent 32%),
      #071218;
  }

  .monkey-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .monkey-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(3, 13, 19, 0.88) 0%, rgba(3, 13, 19, 0.48) 45%, rgba(3, 13, 19, 0.18) 100%),
      linear-gradient(0deg, rgba(3, 13, 19, 0.7) 0%, transparent 48%);
    pointer-events: none;
  }

  .monkey-progress {
    position: absolute;
    top: 50%;
    right: 24px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    color: rgba(255, 255, 255, 0.62);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translateY(-50%);
    writing-mode: vertical-rl;
  }

  .monkey-progress-track {
    position: relative;
    display: block;
    width: 2px;
    height: 112px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.24);
  }

  .monkey-progress-track span {
    position: absolute;
    inset: 0;
    background: #c4e1bc;
    transform: scaleY(var(--story-progress));
    transform-origin: top;
  }

  .monkey-chapters {
    position: relative;
    z-index: 1;
  }

  .monkey-chapter {
    position: relative;
    display: flex;
    min-height: 100svh;
    align-items: center;
    padding: clamp(72px, 8vw, 120px);
    scroll-margin-top: 0;
  }

  .monkey-chapter-right {
    justify-content: flex-end;
  }

  .monkey-panel {
    width: min(680px, 64vw);
    padding: clamp(24px, 3vw, 42px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius);
    background: rgba(3, 13, 19, 0.78);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(12px);
  }

  .monkey-story[data-enhanced='true'] .monkey-panel {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 280ms ease, transform 360ms ease;
  }

  .monkey-story[data-enhanced='true'] .monkey-chapter[data-active='true'] .monkey-panel {
    opacity: 1;
    transform: translateY(0);
  }

  .monkey-panel-wide {
    width: min(980px, 78vw);
  }

  .monkey-panel > * + * {
    margin-top: 18px;
  }

  .monkey-kicker {
    margin: 0;
    color: #c4e1bc;
