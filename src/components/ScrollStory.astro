---
import { getCollection } from 'astro:content';
import {
  agreement,
  approachSteps,
  beyondChatRows,
  ladderLevels,
  problemCards,
  services,
} from '../data/home';
import ContactForm from './ContactForm.astro';
import FaqList from './FaqList.astro';

const useCases = (await getCollection('usecases', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) => new Intl.DateTimeFormat('nl-BE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);

const pad = (value: number) => String(value).padStart(2, '0');

const chapters = [
  { id: 'hero', timeStart: 0, timeEnd: 8, footage: 'ready' },
  { id: 'problemen', timeStart: 8, timeEnd: 15.01, footage: 'ready' },
  { id: 'overdracht', timeStart: 15.01, timeEnd: 32.64, footage: 'ready' },
  { id: 'team', timeStart: 32.64, timeEnd: 50.03, footage: 'ready' },
  { id: 'aanpak', timeStart: 50.03, timeEnd: 57.03, footage: 'ready' },
  { id: 'niveaus', timeStart: 57.03, timeEnd: 64.05, footage: 'ready' },
  { id: 'use-cases', timeStart: 64.05, timeEnd: 71.09, footage: 'ready' },
  { id: 'diensten', timeStart: 71.09, timeEnd: 77.04, footage: 'ready' },
  { id: 'breder-dan-chat', timeStart: 77.04, timeEnd: 85, footage: 'ready' },
  { id: 'ai-act', timeStart: 85, timeEnd: 92.03, footage: 'ready' },
  { id: 'afspraak', timeStart: 92.03, timeEnd: 99.06, footage: 'ready' },
  { id: 'blog', timeStart: 99.06, timeEnd: 106.08, footage: 'ready' },
  { id: 'faq', timeStart: 106.08, timeEnd: 113.11, footage: 'ready' },
  { id: 'contact', timeStart: 113.11, timeEnd: 119.71, footage: 'ready' },
] as const;
---

<section class="monkey-story" data-scroll-story>
  <div class="monkey-stage">
    <video
      class="monkey-video"
      muted
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      data-story-video
    >
      <source data-src="/media/scroll-story/monkai-scroll-story.mp4" type="video/mp4" />
      <source data-src="/media/scroll-story/monkai-scroll-story.webm" type="video/webm" />
    </video>
    <div class="monkey-shade" aria-hidden="true"></div>
    <div
      class="monkey-loader"
      role="status"
      aria-live="polite"
      aria-hidden="true"
      data-story-loader
    >
      <svg class="monkey-loader-tail" viewBox="0 0 72 72" aria-hidden="true">
        <path
          class="monkey-loader-tail-track"
          pathLength="100"
          d="M52 16c-16-8-34 4-32 22 2 17 24 24 36 12 10-10 5-26-8-27-10-1-16 10-10 16 6 7 17 2 15-6"
        ></path>
        <path
          class="monkey-loader-tail-progress"
          pathLength="100"
          data-story-loader-tail
          d="M52 16c-16-8-34 4-32 22 2 17 24 24 36 12 10-10 5-26-8-27-10-1-16 10-10 16 6 7 17 2 15-6"
        ></path>
      </svg>
      <span class="monkey-loader-copy">
        <span data-story-loader-label>Junglefilm laden</span>
        <strong data-story-loader-value>0%</strong>
      </span>
    </div>
  </div>

  <div class="monkey-progress-anchor">
    <div class="monkey-progress-cluster">
      <div class="monkey-progress" aria-hidden="true">
        <span>Monkey mode</span>
        <span class="monkey-progress-track"><span></span></span>
      </div>
      <button
        class="monkey-autoplay"
        type="button"
        aria-label="Monkey-tour afspelen"
        aria-pressed="false"
        aria-disabled="true"
        data-story-autoplay
        data-playing="false"
        disabled
      >
        <span class="monkey-autoplay-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="monkey-chapters">
    <section
      class="monkey-chapter monkey-chapter-hero"
      id="monkey-hero"
      data-monkey-chapter
      data-chapter="hero"
      data-panel-side="left"
      data-panel-vertical="middle"
      data-panel-size="normal"
      data-time-start={chapters[0].timeStart}
      data-time-end={chapters[0].timeEnd}
      data-footage={chapters[0].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">MonkAi Business</p>
        <h1>AI zonder apenstreken<span aria-hidden="true">.</span></h1>
        <p class="monkey-lede">Ik help Vlaamse KMO's rustig en veilig starten met AI. Klein beginnen, herhalen, beheersen.</p>
        <div class="monkey-actions">
          <a class="btn" href="#monkey-contact">Laten we praten</a>
          <a class="monkey-link monkey-link-outline" href="#monkey-aanpak">Bekijk de aanpak</a>
        </div>
        <div class="monkey-meta">
          <span>Inspiratiesessie</span>
          <span>Sparring in kleine groepen</span>
          <span>Bij jou op locatie</span>
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-problemen"
      data-monkey-chapter
      data-chapter="problemen"
      data-panel-side="left"
      data-panel-vertical="middle"
      data-panel-size="normal"
      data-time-start={chapters[1].timeStart}
      data-time-end={chapters[1].timeEnd}
      data-footage={chapters[1].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">Het vertrekpunt</p>
        <h2>Van losse experimenten naar echte impact</h2>
        <div class="monkey-card-list">
          {problemCards.map((card) => (
            <article>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-overdracht"
      data-monkey-chapter
      data-chapter="overdracht"
      data-panel-side="left"
      data-panel-vertical="middle"
      data-panel-size="compact"
      data-time-start={chapters[2].timeStart}
      data-time-end={chapters[2].timeEnd}
      data-footage={chapters[2].footage}
    >
      <div class="monkey-panel monkey-panel-quote">
        <p class="monkey-kicker">De afspraak vanaf dag één</p>
        <h2>Werk slimmer. Niet afhankelijker.</h2>
        <blockquote>Mijn doel is dat je mij niet meer nodig hebt.</blockquote>
        <p>Ik geef een kickstart, draag over en blijf niet plakken.</p>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-team"
      data-monkey-chapter
      data-chapter="team"
      data-panel-side="left"
      data-panel-vertical="middle"
      data-panel-size="compact"
      data-time-start={chapters[3].timeStart}
      data-time-end={chapters[3].timeEnd}
      data-footage={chapters[3].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">Het team</p>
        <h2>Klein team. Korte lijnen.</h2>
        <div class="monkey-person">
          <img src="/media/stijn.jpg" alt="Stijn De Ketelaere" width="88" height="88" loading="lazy" />
          <div>
            <h3>Stijn De Ketelaere</h3>
            <p>AI-adoptiecoach vanuit Oudenaarde, met technische ervaring en beide voeten in het Vlaamse KMO-landschap.</p>
          </div>
        </div>
        <p>Je werkt rechtstreeks met mij, van de eerste sessie tot de overdracht. Het team groeit met mensen die dezelfde nuchtere aanpak delen.</p>
        <a class="monkey-link" href="https://www.linkedin.com/in/stijndeketelaere/" target="_blank" rel="noopener">Volg Stijn op LinkedIn</a>
      </div>
    </section>

    <section
      class="monkey-chapter"
      id="monkey-aanpak"
      data-monkey-chapter
      data-chapter="aanpak"
      data-panel-side="right"
      data-panel-vertical="middle"
      data-panel-size="compact"
      data-time-start={chapters[4].timeStart}
      data-time-end={chapters[4].timeEnd}
      data-footage={chapters[4].footage}
    >
      <div class="monkey-panel">
        <p class="monkey-kicker">De aanpak</p>
        <h2>Zo pakken we het aan</h2>
        <div class="monkey-step-grid">
          {approachSteps.map((step) => (
