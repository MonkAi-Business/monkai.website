---
const storySteps = [
  {
    kicker: '01 / Begrijpen',
    title: 'Van losse ideeën naar een werkbare flow.',
    text: 'Geen AI om de AI. We zoeken waar technologie echt tijd vrijmaakt en bouwen van daaruit verder.',
    start: 0.135,
    side: 'right',
  },
  {
    kicker: '02 / Beginnen',
    title: 'Klein beginnen. Herhalen. Beheersen.',
    text: 'Eerst één helder experiment. Daarna bijsturen, afspraken maken en pas dan opschalen.',
    start: 0.275,
    side: 'left',
  },
  {
    kicker: '03 / Verder kijken',
    title: 'AI is breder dan chat.',
    text: 'Van kennis en automatisering tot beeldherkenning, connected workers en slimme interfaces.',
    start: 0.405,
    side: 'left',
  },
  {
    kicker: '04 / Samenwerken',
    title: 'Je hoeft dit niet alleen uit te zoeken.',
    text: 'Ik werk naast je mensen, in gewone taal. Wat werkt dragen we over. Wat niet werkt laten we liggen.',
    start: 0.57,
    side: 'left',
  },
  {
    kicker: '05 / Verankeren',
    title: 'Een aanpak die blijft staan.',
    text: 'Geen losse demo, wel een ritme waarmee jouw team zelf verder kan.',
    start: 0.86,
    side: 'left',
    approach: true,
  },
];
---

<section class="scroll-story" id="top" data-scroll-story>
  <div class="story-stage">
    <video
      class="story-video"
      muted
      playsinline
      preload="none"
      poster="/media/scroll-story/monkai-scroll-story-poster.jpg"
      aria-hidden="true"
      tabindex="-1"
      data-story-video
    >
      <source
        data-src="/media/scroll-story/monkai-scroll-story.webm"
        type="video/webm"
        media="(min-width: 769px)"
      />
      <source
        data-src="/media/scroll-story/monkai-scroll-story.mp4"
        type="video/mp4"
        media="(min-width: 769px)"
      />
    </video>

    <div class="story-shade" aria-hidden="true"></div>

    <div class="story-overlays">
      <div
        class="story-overlay story-overlay-hero"
        data-story-overlay
        data-start="0"
        data-active="true"
        aria-hidden="false"
      >
        <p class="story-kicker">MonkAi Business</p>
        <h1 aria-label="AI zonder apenstreken.">AI zonder apenstreken<span aria-hidden="true">.</span></h1>
        <p class="story-lede">Ik help Vlaamse KMO's rustig en veilig starten met AI. Klein beginnen, herhalen, beheersen.</p>
        <div class="story-cta">
          <a class="btn story-cta-primary" href="#contact">Laten we praten</a>
          <a class="story-link" href="#aanpak">Bekijk de aanpak</a>
        </div>
        <div class="story-meta">
          <span>Inspiratiesessie</span>
          <span aria-hidden="true">|</span>
          <span>Sparring in kleine groepen</span>
          <span aria-hidden="true">|</span>
          <span>Bij jou op locatie</span>
        </div>
        <div class="scroll-hint" aria-hidden="true">
          <span>Scroll om te ontdekken</span>
          <span class="scroll-arrow">↓</span>
        </div>
      </div>

      {storySteps.map((step) => (
        <article
          class={`story-overlay story-overlay-step story-overlay-${step.side}`}
          data-story-overlay
          data-start={step.start}
          data-active="false"
          aria-hidden="true"
        >
          <p class="story-kicker">{step.kicker}</p>
          <h2>{step.title}</h2>
          <p>{step.text}</p>
          {step.approach && (
            <div class="story-approach" aria-label="De vier stappen van onze aanpak">
              <span>Inspireren</span>
              <span>Kiezen</span>
              <span>Experimenteren</span>
              <span>Verankeren</span>
            </div>
          )}
        </article>
      ))}
    </div>

    <div class="story-progress" aria-hidden="true">
      <span class="story-progress-label">Scroll</span>
      <span class="story-progress-track"><span></span></span>
    </div>
  </div>

  <div class="story-fallback">
    <div class="story-fallback-inner">
      <p class="story-kicker">MonkAi Business</p>
      <h1 aria-label="AI zonder apenstreken.">AI zonder apenstreken<span aria-hidden="true">.</span></h1>
      <p class="story-lede">Ik help Vlaamse KMO's rustig en veilig starten met AI. Klein beginnen, herhalen, beheersen.</p>
      <div class="story-cta">
        <a class="btn story-cta-primary" href="#contact">Laten we praten</a>
        <a class="story-link" href="#aanpak">Bekijk de aanpak</a>
      </div>
      <div class="story-meta">
        <span>Inspiratiesessie</span>
        <span aria-hidden="true">|</span>
        <span>Sparring in kleine groepen</span>
        <span aria-hidden="true">|</span>
        <span>Bij jou op locatie</span>
      </div>
    </div>
  </div>
</section>

<script>
  const story = document.querySelector<HTMLElement>('[data-scroll-story]');
  const desktop = window.matchMedia('(min-width: 769px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (story && desktop.matches && !reducedMotion.matches) {
    const video = story.querySelector<HTMLVideoElement>('[data-story-video]');
    const overlays = Array.from(story.querySelectorAll<HTMLElement>('[data-story-overlay]'));

    if (video && overlays.length > 0) {
      video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((source) => {
        source.src = source.dataset.src ?? '';
      });
      video.load();
      story.dataset.enhanced = 'true';

      const starts = overlays.map((overlay) => Number(overlay.dataset.start ?? 0));
      let targetTime = 0;
      let renderedTime = 0;
      let activeIndex = -1;
      let duration = 58.08;
      let visible = true;
      let animationFrame = 0;
      let lastSeek = 0;

      const clamp = (value: number, minimum: number, maximum: number) =>
        Math.min(Math.max(value, minimum), maximum);

      const setActiveOverlay = (progress: number) => {
        let nextIndex = 0;
        for (let index = 0; index < starts.length; index += 1) {
          if (progress >= starts[index]) nextIndex = index;
        }

        if (nextIndex === activeIndex) return;
        activeIndex = nextIndex;

        overlays.forEach((overlay, index) => {
          const isActive = index === activeIndex;
          overlay.dataset.active = String(isActive);
          overlay.setAttribute('aria-hidden', String(!isActive));
        });
      };

      const updateTarget = () => {
        const scrollableDistance = story.offsetHeight - window.innerHeight;
        const top = story.getBoundingClientRect().top;
        const progress = scrollableDistance > 0
          ? clamp(-top / scrollableDistance, 0, 1)
          : 0;

        targetTime = progress * Math.max(duration - 0.04, 0);
        story.style.setProperty('--story-progress', String(progress));
        setActiveOverlay(progress);
      };

      const render = (time: number) => {
        if (!visible) {
          animationFrame = 0;
          return;
        }

        const difference = targetTime - renderedTime;
        if (Math.abs(difference) > 6) {
          renderedTime = targetTime;
        } else {
          renderedTime += difference * 0.2;
        }

        if (
          video.readyState >= HTMLMediaElement.HAVE_METADATA &&
          time - lastSeek > 42 &&
          Math.abs(video.currentTime - renderedTime) > 0.015 &&
          !video.seeking
        ) {
          video.currentTime = clamp(renderedTime, 0, Math.max(duration - 0.04, 0));
          lastSeek = time;
        }

        animationFrame = window.requestAnimationFrame(render);
      };

      const startRendering = () => {
        if (!animationFrame) animationFrame = window.requestAnimationFrame(render);
      };

      video.addEventListener('loadedmetadata', () => {
        duration = Number.isFinite(video.duration) ? video.duration : duration;
        updateTarget();
        renderedTime = targetTime;
        video.currentTime = targetTime;
        startRendering();
      }, { once: true });

      const observer = new IntersectionObserver((entries) => {
        visible = entries[0]?.isIntersecting ?? false;
        if (visible) {
          updateTarget();
          startRendering();
        }
      });
      observer.observe(story);

      window.addEventListener('scroll', updateTarget, { passive: true });
      window.addEventListener('resize', updateTarget, { passive: true });
      window.addEventListener('pageshow', updateTarget);
      updateTarget();
      startRendering();
    }
  }

  document.querySelectorAll('.story-cta-primary').forEach((cta) => {
    cta.addEventListener('click', () => {
      window.posthog?.capture('hero_cta_clicked');
    });
  });
</script>

<style>
  .scroll-story {
    --story-progress: 0;
    position: relative;
    border-top: 0;
  }

  .story-stage {
    display: none;
  }

  .story-fallback {
    position: relative;
    display: flex;
    min-height: min(760px, calc(100svh - 84px));
    align-items: center;
    padding: 92px 64px;
    overflow: hidden;
    color: #fff;
    background:
      linear-gradient(90deg, rgba(4, 18, 25, 0.9) 0%, rgba(4, 18, 25, 0.6) 46%, rgba(4, 18, 25, 0.12) 78%),
      url('/media/scroll-story/monkai-scroll-story-poster.jpg') 66% center / cover no-repeat;
  }

  .story-fallback-inner {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(680px, 100%);
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .story-kicker {
    margin: 0;
    color: #c4e1bc;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    font-size: clamp(48px, 6vw, 82px);
    font-weight: 500;
    line-height: 1.02;
    text-wrap: balance;
  }

  h1 span {
    color: #78a66f;
  }

  .story-lede {
    max-width: 630px;
    margin: 0;
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.6;
  }

  .story-cta {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .story-cta .btn {
    color: var(--on-green);
  }

  .story-link {
    padding: 14px 3px;
    border-bottom: 1.5px solid rgba(255, 255, 255, 0.8);
    color: #fff;
    font-weight: 600;
  }

  .story-link:hover {
    border-color: #c4e1bc;
    color: #c4e1bc;
  }

  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    color: rgba(255, 255, 255, 0.68);
    font-size: 14px;
  }

  @media (min-width: 769px) and (prefers-reduced-motion: no-preference) {
    .scroll-story[data-enhanced='true'] {
      height: 700vh;
      min-height: 4300px;
      background: #071218;
    }

    .scroll-story[data-enhanced='true'] .story-fallback {
      display: none;
    }

    .scroll-story[data-enhanced='true'] .story-stage {
      position: sticky;
      top: 0;
      display: block;
      height: 100vh;
      min-height: 620px;
      overflow: hidden;
      background: #071218;
      color: #fff;
    }

    .story-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .story-shade {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(3, 13, 19, 0.8) 0%, rgba(3, 13, 19, 0.38) 42%, rgba(3, 13, 19, 0.08) 70%),
        linear-gradient(0deg, rgba(3, 13, 19, 0.58) 0%, transparent 42%);
      pointer-events: none;
    }

    .story-overlays {
      position: absolute;
      inset: 0;
      z-index: 2;
      width: 100%;
      height: 100%;
    }

    .story-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 22px;
      padding: clamp(56px, 7vw, 112px);
      opacity: 0;
      pointer-events: none;
      transform: translateY(24px);
      transition: opacity 320ms ease, transform 420ms ease;
    }

    .story-overlay[data-active='true'] {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .story-overlay-hero {
      width: min(880px, 72vw);
      justify-content: center;
    }

    .story-overlay-step {
      width: min(700px, 58vw);
    }

    .story-overlay-right {
      right: 0;
      left: auto;
      align-items: flex-end;
      text-align: right;
    }

    .story-overlay-step h2 {
      max-width: 650px;
      font-size: clamp(42px, 5vw, 68px);
      font-weight: 500;
      line-height: 1.04;
      text-wrap: balance;
    }

    .story-overlay-step > p:last-of-type {
      max-width: 560px;
      margin: 0;
      color: rgba(255, 255, 255, 0.82);
      font-size: clamp(17px, 1.5vw, 20px);
      line-height: 1.6;
    }

    .story-overlay-right > p {
      margin-left: auto;
    }

    .story-approach {
      display: grid;
      width: min(620px, 100%);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 9px;
      margin-top: 4px;
    }

    .story-approach span {
      padding: 11px 13px;
      border: 1px solid rgba(255, 255, 255, 0.26);
      border-radius: var(--radius-sm);
      background: rgba(3, 13, 19, 0.36);
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.04em;
    }

    .scroll-hint {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 10px;
      color: rgba(255, 255, 255, 0.64);
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .scroll-arrow {
      color: #c4e1bc;
      font-size: 18px;
    }

    .story-progress {
      position: absolute;
      right: 28px;
      top: 50%;
      z-index: 3;
      display: flex;
      align-items: center;
      gap: 12px;
      color: rgba(255, 255, 255, 0.62);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      transform: translateY(-50%);
      writing-mode: vertical-rl;
    }

    .story-progress-track {
      position: relative;
      width: 2px;
      height: 112px;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.25);
    }

    .story-progress-track span {
      position: absolute;
      inset: 0;
      background: #c4e1bc;
      transform: scaleY(var(--story-progress));
      transform-origin: top;
    }
  }

  @media (max-width: 768px) {
    .story-fallback {
      min-height: 720px;
      padding: 72px 22px 58px;
      align-items: flex-end;
      background:
        linear-gradient(0deg, rgba(4, 18, 25, 0.92) 0%, rgba(4, 18, 25, 0.52) 58%, rgba(4, 18, 25, 0.08) 100%),
        url('/media/scroll-story/monkai-scroll-story-poster.jpg') 44% center / cover no-repeat;
    }

    .story-fallback-inner {
      gap: 20px;
    }

    h1 {
      font-size: clamp(40px, 12vw, 54px);
    }

    .story-lede {
      font-size: 17px;
    }

    .story-cta {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }

    .story-cta .btn,
    .story-link {
      text-align: center;
    }

    .story-meta {
      justify-content: center;
      font-size: 13px;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-story {
      height: auto;
      min-height: 0;
    }

    .story-stage {
      display: none;
    }
  }
</style>
