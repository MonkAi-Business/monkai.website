<section class="section statement">
  <div class="statement-inner">
    <div class="statement-quote">Mijn doel is dat je mij niet meer nodig hebt.</div>
    <p class="lede">Ik geef een kickstart en draag over. Ik blijf niet plakken.</p>
  </div>
</section>
<style>
  .statement { padding:150px 64px; display:flex; flex-direction:column; align-items:center; text-align:center; }
  .statement-inner { display:flex; flex-direction:column; align-items:center; gap:20px; }
  .statement-quote { font-family:var(--font-serif); font-size:52px; font-weight:500; line-height:1.15; max-width:760px; text-wrap:pretty; }
  .lede { margin:0; font-size:18px; color:var(--muted); }
  @media (max-width:768px){
    .statement{ padding:90px 22px; }
    .statement-quote{ font-size:32px; line-height:1.2; }
    .lede{ font-size:16px; }
  }
</style>
