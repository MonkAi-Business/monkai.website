---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) => new Intl.DateTimeFormat('nl-BE', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
---
<section class="section blog-teaser">
  <div class="container blog-teaser-inner">
    <div class="head">
      <h2>Uit de blog</h2>
      <a class="link-underline" href="/blog">Alle artikels</a>
    </div>
    <div class="grid">
      {posts.map((post) => (
        <a class="card" href={`/blog/${post.id}`}>
          {post.data.image && <img class="thumb" src={post.data.image} alt={post.data.imageAlt ?? ''} width="600" height="400" loading="lazy" />}
          <div class="card-body">
            <div class="date">{fmt(post.data.date)}</div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .blog-teaser { background: var(--section-alt); }
  .blog-teaser-inner { display: flex; flex-direction: column; gap: 40px; }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  h2 { font-size: 40px; font-weight: 500; }
  .link-underline { color: var(--ink); font-weight: 600; border-bottom: 1.5px solid var(--green); padding-bottom: 2px; white-space: nowrap; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); display: flex; flex-direction: column; color: var(--ink); overflow: hidden; }
  .card:hover { color: var(--ink); border-color: var(--green); }
  .thumb { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; display: block; border-bottom: 1px solid var(--border); }
  .card-body { padding: 26px 30px 30px; display: flex; flex-direction: column; gap: 12px; }
  .date { font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
  .card h3 { margin: 0; font-family: var(--font-serif); font-size: 22px; font-weight: 600; line-height: 1.3; }
  .card p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--muted); }
  @media (max-width: 768px) {
    h2 { font-size: 30px; }
    .grid { grid-template-columns: 1fr; gap: 14px; }
    .card-body { padding: 22px; }
  }
</style>
