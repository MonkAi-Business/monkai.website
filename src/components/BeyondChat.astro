---
const rows = [
  { title: 'Augmented reality', text: 'instructies op de plek waar je werkt' },
  { title: 'Smart glasses', text: 'handen vrij, informatie in beeld' },
  { title: 'Computer vision', text: "camera's die controleren en tellen" },
  { title: 'Connected worker', text: 'de werkvloer verbonden met de systemen' },
];
---
<section class="section beyond-chat">
  <div class="container beyond-chat-inner">
    <div class="beyond-chat-head">
      <h2>AI is breder dan chat</h2>
      <p class="lede">Generatieve AI is het vertrekpunt, niet de grens. Waar het past kijk ik ook naar wat er op de werkvloer zelf kan.</p>
    </div>
    <div class="beyond-chat-list">
      {rows.map((row) => (
        <div class="beyond-chat-row">
          <span class="beyond-chat-title">{row.title}</span>
          <span class="beyond-chat-text">{row.text}</span>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .beyond-chat-inner { display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:start; }
  .beyond-chat-head { display:flex; flex-direction:column; gap:14px; }
  h2 { font-size:40px; font-weight:500; text-wrap:pretty; }
  .lede { margin:0; font-size:17px; line-height:1.65; color:var(--muted); }
  .beyond-chat-list { display:flex; flex-direction:column; }
  .beyond-chat-row { display:flex; justify-content:space-between; align-items:baseline; padding:16px 0; border-bottom:1px solid var(--border); }
  .beyond-chat-row:last-child { border-bottom:none; }
  .beyond-chat-title { font-size:18px; font-weight:500; }
  .beyond-chat-text { font-size:15px; color:var(--muted); }
  @media (max-width:768px){
    .beyond-chat-inner{ grid-template-columns:1fr; gap:20px; }
    h2{ font-size:30px; }
    .beyond-chat-row{ flex-direction:column; gap:2px; padding:14px 0; align-items:flex-start; }
    .beyond-chat-title{ font-size:17px; }
    .beyond-chat-text{ font-size:14px; }
  }
</style>
