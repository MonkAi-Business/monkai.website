---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/#aanpak', label: 'Aanpak' },
  { href: '/#diensten', label: 'Diensten' },
  { href: '/#over', label: 'Het team' },
  { href: '/blog', label: 'Blog' },
];
---

<header class="nav">
  <div class="nav-bar">
    <a href="/" class="nav-logo" aria-label="MonkAi Business - home">
      <span class="logo-desktop"><Logo variant="light" /></span>
      <span class="logo-mobile"><Logo variant="light" iconSize={26} wordmarkSize={19} showBusiness={false} /></span>
    </a>

    <nav class="nav-links" aria-label="Hoofdnavigatie">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href="/#contact" class="btn nav-cta">Laten we praten</a>
    </nav>

    <button
      type="button"
      class="nav-toggle"
      aria-label="Menu openen"
      aria-expanded="false"
      aria-controls="nav-mobile-menu"
      data-nav-toggle
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
  </div>

  <nav
    id="nav-mobile-menu"
    class="nav-mobile"
    aria-label="Mobiele navigatie"
    data-nav-mobile
  >
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
    <a href="/#contact" class="btn nav-cta-mobile">Laten we praten</a>
    <div class="nav-theme"><ThemeToggle /></div>
  </nav>

  <!-- Op desktop hangt de schakelaar net onder de scheidingslijn, rechts uitgelijnd
       met de balk erboven. Absoluut geplaatst, zodat de balk zijn hoogte houdt en de
       pagina er niet door opschuift. -->
  <div class="nav-theme-float"><ThemeToggle /></div>
</header>

<script>
  type MonkeyNavigationWindow = Window & {
    scrollToMonkeyChapter?: (id: string) => void;
  };

  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.querySelector('[data-nav-mobile]');
  const monkeyDesktop = window.matchMedia('(min-width: 769px)');
  const monkeyTargets: Record<string, string> = {
    aanpak: 'aanpak',
    diensten: 'diensten',
    over: 'team',
    contact: 'contact',
  };

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.getAttribute('data-open') === 'true';
    menu?.setAttribute('data-open', String(!isOpen));
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.setAttribute('data-open', 'false');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('.nav a[href]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (
        document.documentElement.dataset.theme !== 'monkey'
        || !monkeyDesktop.matches
        || window.location.pathname !== '/'
      ) {
        return;
      }

      const destination = new URL(link.href, window.location.href);
      const fragment = destination.hash.slice(1);
      const chapter = monkeyTargets[fragment];
      const navigate = (window as MonkeyNavigationWindow).scrollToMonkeyChapter;

      if (destination.pathname === '/' && chapter && navigate) {
        event.preventDefault();
        navigate(chapter);
      }
    });
  });
</script>

<style>
  .nav {
    position: relative;
    background: var(--bg-page);
    border-bottom: 1px solid var(--border);
  }

  .nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 64px;
  }

  .nav-logo {
    display: inline-flex;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 36px;
    font-size: 15px;
    font-weight: 500;
  }

  .nav-links a {
    color: var(--ink);
  }

  .nav-links a:hover {
    color: var(--green-hover);
  }

  /* Bewust klein en kleurloos: het is een hulpmiddel, geen tweede oproep tot actie.
     top:100% is de onderkant van het opvulvak, dus net boven de rand; de 9px zetten
     hem daar netjes onder. */
  .nav-theme-float {
    position: absolute;
    top: calc(100% + 9px);
    right: 64px;
    z-index: 5;
    display: flex;
  }

  /* De .btn-tekst is wit, maar .nav-links a / .nav-mobile a (--ink) is
     specifieker en zou de knoptekst donker maken op de groene knop.
     Deze regels winnen op specificiteit en houden de tekst leesbaar wit. */
  .nav-links a.nav-cta,
  .nav-links a.nav-cta:hover {
    padding: 11px 20px;
    color: var(--on-green);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 14px 6px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .nav-toggle-bar {
    width: 22px;
    height: 1.5px;
    background: var(--ink);
  }

  .nav-mobile {
    display: none;
    flex-direction: column;
    gap: 20px;
    padding: 22px;
    border-top: 1px solid var(--border);
    font-size: 16px;
    font-weight: 500;
    text-align: center;
  }

  .nav-mobile a {
    color: var(--ink);
  }

  .nav-mobile a.nav-cta-mobile,
  .nav-mobile a.nav-cta-mobile:hover {
    width: 100%;
    box-sizing: border-box;
    text-align: center;
    color: var(--on-green);
  }

  .logo-mobile {
    display: none;
  }

  /* Op mobiel staat de schakelaar in het uitklapmenu, niet naast de hamburger:
     daar is bij 390 pixels geen ruimte voor. */
  .nav-theme {
    display: flex;
    justify-content: center;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 768px) {
    .nav-bar {
      padding: 18px 22px;
    }

    .nav-links {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }

    .logo-desktop {
      display: none;
    }

    .logo-mobile {
      display: inline-flex;
    }

    .nav-mobile[data-open='true'] {
      display: flex;
    }

    /* Op mobiel zit de schakelaar in het uitklapmenu; de zwevende versie zou daar
       over de inhoud van de pagina hangen. */
    .nav-theme-float {
      display: none;
    }
  }
</style>
