---
import Logo from './Logo.astro';

const sitemap = [
  { href: '#aanpak', label: 'Aanpak' },
  { href: '#diensten', label: 'Diensten' },
  { href: '#over', label: 'Over Stijn' },
  { href: '#blog', label: 'Blog' },
  { href: '#contact', label: 'Contact' },
];
---

<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-columns">
      <div class="footer-brand">
        <Logo variant="dark" />
        <p class="footer-tagline">
          AI zonder apenstreken. Rustig en veilig starten met AI voor Vlaamse KMO's.
        </p>
      </div>

      <div class="footer-col">
        <div class="footer-label">Sitemap</div>
        {sitemap.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>

      <div class="footer-col">
        <div class="footer-label">SDK Solutions BV</div>
        <span>Robert De Preesterstraat 55, 9700 Oudenaarde</span>
        <span>BTW BE 1027.019.469</span>
        <span>hallo@monkai.business</span>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-legal">
        <a href="#privacy">Privacy</a>
        <a href="#cookies">Cookies</a>
      </div>
      <span class="footer-mono">Geen apen nodig gehad bij het maken van deze site. Wel AI.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    color: var(--dark-text);
    padding: 64px;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-tagline {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    max-width: 320px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15px;
  }

  .footer-col a {
    color: var(--dark-text);
  }

  .footer-col a:hover {
    color: var(--bg-page);
  }

  .footer-label {
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dark-dim);
    font-weight: 600;
    margin-bottom: 4px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    /* No token for this dark hairline; distinct from --border which is tuned for the light theme. */
    border-top: 1px solid #3A3D33;
    padding-top: 24px;
    font-size: 14px;
    color: var(--dark-dim);
  }

  .footer-legal {
    display: flex;
    gap: 24px;
  }

  .footer-legal a {
    color: var(--dark-dim);
  }

  .footer-legal a:hover {
    color: var(--bg-page);
  }

  .footer-mono {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 48px 22px;
    }

    .footer-columns {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .footer-tagline {
      max-width: none;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>
