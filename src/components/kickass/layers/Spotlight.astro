---
// Variant 6: een lichtbundel rond de cursor onthult de pagina. De positie loopt
// via twee CSS-variabelen op <html>, bijgewerkt met requestAnimationFrame zodat
// er hooguit één update per frame is - hetzelfde patroon als BackToTop.astro.
---

<div class="bundel" aria-hidden="true"></div>

<slot name="hero" />
<slot name="rest" />

<script>
  const root = document.documentElement;
  const rustig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fijneAanwijzer = window.matchMedia('(pointer: fine)').matches;

  if (!rustig && fijneAanwijzer) {
    let x = window.innerWidth / 2;
    let y = window.innerHeight / 2;
    let gepland = false;

    const schrijf = () => {
      gepland = false;
      root.style.setProperty('--sx', `${x}px`);
      root.style.setProperty('--sy', `${y}px`);
    };

    window.addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
      if (!gepland) {
        gepland = true;
        window.requestAnimationFrame(schrijf);
      }
    });

    schrijf();
  }
  // Geen aanraakscherm en geen rustige stand: dan blijft --sx/--sy gewoon op de
  // startwaarde uit :root staan (zie hieronder), en zonder JavaScript al
  // helemaal - de bundel staat dan stil in het midden, wat de opdracht vraagt.
</script>

<style is:global>
  :root[data-kickass='spotlight'] {
    --kickass-laag: 'spotlight';

    /* Middelpunt tot het script iets anders zegt. Zonder deze twee valt de
       bundel terug op het midden van het scherm, wat precies is wat we willen
       op een aanraakscherm of zonder JavaScript. */
    --sx: 50vw;
    --sy: 45vh;

    --bg-page: #060607;
    --bg-canvas: #0A0A0B;
    --section-alt: #08080A;
    /* Lichtjes doorschijnend in plaats van dekkend: de bundel ligt nu ONDER de
       inhoud (zie .bundel hieronder) en moet door de kaarten heen kunnen
       schijnen, anders blijft het effect beperkt tot de kieren tussen kaarten.
       --bg-page is altijd donkerder dan of gelijk aan --card, dus wat er door
       de kaart heen schemert kan de effectieve kleur alleen maar donkerder
       maken, nooit lichter - dat verhoogt het contrast voor de lichte tekst
       erop, het verlaagt het nooit. Zie de opmerking bij --muted. */
    --card: color-mix(in srgb, #101012 84%, transparent);
    --card-alt: color-mix(in srgb, #16161A 86%, transparent);
    --border: #26262B;

    --ink: #F3F2EE;
    --ink-soft: #B9B8B2;
    /* Opgehoogd van #7C7B76 naar #86857F, een bescheiden stap (niet de #96958F
       van de vorige ronde). Nu de bundel niet meer bovenop tekst ligt (zie
       .bundel), is het enige contrastprobleem de basiswaarde zelf: zelfs
       zonder enige verdonkering zat --muted-tekst op --card met de
       oorspronkelijke hex op 4,48:1, net onder de vereiste 4,5:1. #86857F haalt
       daar 5,14:1, met marge. Overal waar de kaart door de bundel gedimd wordt
       (verder van de cursor) gaat dat cijfer alleen maar omhoog, nooit omlaag -
       zie de opmerking bij --card. */
    --muted: #86857F;

    --green: #9CB382;
    --green-hover: #C0D3A8;
    --green-light: #9CB382;
    --on-green: #10130B;

    /* Zelfde redenering als --card: doorschijnend zodat de bundel ook door de
       donkere Raad-van-advies-kaart en de rij "Versnellen" heen zichtbaar
       blijft. */
    --dark: color-mix(in srgb, #16161A 84%, transparent);
    --dark-text: #F3F2EE;
    --dark-dim: #96958F;
    --dark-border: #2E2E34;
    --dark-bright: #FFFFFF;

    --radius: 10px;
    --radius-sm: 6px;
  }

  /* Fixronde 1 zette de bundel bovenop de inhoud (z-index 400) en moest de
     opaciteit daarom fors afzwakken: een zwarte waas over lichte tekst op een
     donkere pagina trekt tekst én achtergrond allebei naar zwart, en dat
     sloopt het contrast sneller dan de opaciteit doet vermoeden. De bundel ligt
     nu ONDER de secties (z-index 0, .section zit op 1), zodat hij alleen de
     achtergrond verduistert en de tekst zelf altijd op volle helderheid blijft
     staan. Een donkerdere achtergrond onder lichte tekst verhóógt het contrast
     net, dus de opaciteit kan weer dicht bij de oorspronkelijke 0,62 - hier
     0,58, met de middelste stop mee opgeschaald. Klikken gaan er sowieso
     doorheen omdat de bundel achterin ligt, pointer-events:none staat er nog
     bij voor de duidelijkheid. */
  :root[data-kickass='spotlight'] .bundel {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      circle 320px at var(--sx) var(--sy),
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.24) 55%,
      rgba(0, 0, 0, 0.58) 100%
    );
  }

  /* Een tweede, warmere gloed onder de inhoud, zodat het licht op de pagina
     valt in plaats van er alleen overheen te liggen. rgba(156, 179, 130, ...)
     is exact --green, dus color-mix in plaats van een letterlijk rgb-tripel. */
  :root[data-kickass='spotlight'] body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      circle 420px at var(--sx) var(--sy),
      color-mix(in srgb, var(--green) 14%, transparent) 0%,
      transparent 70%
    );
  }

  :root[data-kickass='spotlight'] .section { position: relative; z-index: 1; }

  /* DemoServices zet op de section zelf een ondoorzichtige achtergrond
     (var(--section-alt)). Die zit boven body::before en .bundel (z-index 1
     tegenover 0) en zou ze daar dus volledig aan het zicht onttrekken.
     Transparant maken lost dat op, net als bij Aurora - de kaarten erin
     blijven zelf licht doorschijnend via --card, zie hierboven. */
  :root[data-kickass='spotlight'] .services { background: transparent; }

  /* Kaarten krijgen een rand die naar het licht wijst. */
  :root[data-kickass='spotlight'] .service-card,
  :root[data-kickass='spotlight'] .ladder-row {
    position: relative;
  }

  :root[data-kickass='spotlight'] .service-card::after,
  :root[data-kickass='spotlight'] .ladder-row::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    /* Dit pseudo-element is absoluut gepositioneerd op de kaart, dus zonder
       background-attachment:fixed wordt "at var(--sx) var(--sy)" gelezen als
       pixels vanaf de linkerbovenhoek van de KAART zelf, niet van het
       viewport - de rand zou dan alleen oplichten wanneer de cursor toevallig
       vlak bij die hoek van de pagina staat, in plaats van vlak bij de kaart.
       fixed dwingt dezelfde viewport-coördinaten af als bij .bundel
       hierboven, dat wél goed staat omdat het zelf inset:0 op de hele
       viewport heeft. */
    background: radial-gradient(
      circle 380px at var(--sx) var(--sy),
      color-mix(in srgb, var(--green) 90%, transparent),
      transparent 100%
    );
    background-attachment: fixed;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }

  :root[data-kickass='spotlight'] h1 { font-size: 76px; letter-spacing: -0.03em; }

  /* DemoHero.astro verkleint h1 zelf onder 768px (zie de terminal-laag voor
     dezelfde valkuil): zonder dit blok wint de 76px hierboven op elke breedte. */
  @media (max-width: 768px) {
    :root[data-kickass='spotlight'] h1 { font-size: 40px; }
    :root[data-kickass='spotlight'] .bundel {
      /* Geen fijne aanwijzer op mobiel: het script slaat pointermove dan over
         en --sx/--sy staan vast op de startwaarde uit :root hierboven. Dus
         var(--sx) var(--sy) gebruiken in plaats van een eigen vaste positie
         te dupliceren. */
      background: radial-gradient(circle 220px at var(--sx) var(--sy), rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.58) 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :root[data-kickass='spotlight'] .bundel { display: none; }
  }
</style>
