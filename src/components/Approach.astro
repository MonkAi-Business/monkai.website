---
import { approachSteps } from '../data/home';
---
<section class="section approach">
  <div class="container approach-inner">
    <h2>De aanpak</h2>
    <div class="approach-grid">
      {approachSteps.map((step) => (
        <div class="approach-step">
          <div class="approach-num">{step.num}</div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .approach-inner { display:flex; flex-direction:column; gap:44px; }
  h2 { font-size:40px; font-weight:500; }
  .approach-grid { display:grid; grid-template-columns:repeat(4, 1fr); gap:24px; }
  .approach-step { display:flex; flex-direction:column; gap:10px; border-top:2px solid var(--green); padding-top:18px; }
  .approach-num { font-family:var(--font-mono); font-size:13px; color:var(--muted); }
  .approach-step h3 { font-size:22px; font-weight:600; }
  .approach-step p { margin:0; font-size:16px; line-height:1.65; color:var(--muted); }
  @media (max-width:768px){
    h2{ font-size:30px; }
    .approach-grid{ grid-template-columns:1fr; gap:20px; }
    .approach-step{ padding-top:14px; gap:6px; }
    .approach-step h3{ font-size:20px; }
  }
</style>
