---
import { render } from 'astro:content';
import { readingTimeLabel } from '../utils/readingTime';
import type { Post } from '../utils/posts';

interface Props {
  post: Post;
  backHref?: string;
  backLabel?: string;
}

const { post, backHref = '/blog', backLabel = 'Alle artikels' } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => new Intl.DateTimeFormat('nl-BE', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
const readingTime = readingTimeLabel(post.body ?? '');
---
<article class="container article">
  <div class="meta"><span>{fmt(post.data.date)}</span><span class="dot">·</span><span>{readingTime}</span><span class="dot">·</span><span>Door <a rel="author" href="/stijn-de-ketelaere">Stijn De Ketelaere</a></span></div>
  <h1>{post.data.title}</h1>
  {post.data.image && (
    <img class="cover" src={post.data.image} alt={post.data.imageAlt ?? ''} width="1200" height="800" loading="eager" />
  )}
  <div class="prose"><Content /></div>
  <a class="back" href={backHref}>&larr; {backLabel}</a>
</article>
<style>
  .article { max-width: 720px; }
  .meta { font-family: var(--font-mono); font-size: 13px; color: var(--muted); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .meta .dot { color: var(--border); }
  .meta a { color: var(--muted); text-decoration: underline; text-underline-offset: 2px; }
  .meta a:hover { color: var(--green); }
  h1 { font-size: 44px; font-weight: 500; line-height: 1.2; margin: 12px 0 24px; text-wrap: pretty; }
  .cover { width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--border); margin: 0 0 36px; }
  .prose { line-height: 1.7; font-size: 17px; color: var(--ink-soft); }
  .prose :global(h2) { font-family: var(--font-serif); font-size: 26px; font-weight: 600; color: var(--ink); margin: 40px 0 16px; }
  .prose :global(h3) { font-family: var(--font-serif); font-size: 21px; font-weight: 600; color: var(--ink); margin: 32px 0 14px; }
  .prose :global(p) { margin: 0 0 20px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 20px; padding-left: 22px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(a) { color: var(--green); text-decoration: underline; }
  .prose :global(strong) { color: var(--ink); }
  .back { display: inline-block; margin-top: 40px; color: var(--ink); font-weight: 600; border-bottom: 1.5px solid var(--green); padding-bottom: 2px; }
  @media (max-width: 768px) {
    h1 { font-size: 30px; margin: 10px 0 18px; }
    .prose { font-size: 16px; }
  }
</style>
