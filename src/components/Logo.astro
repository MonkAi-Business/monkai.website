---
export interface Props {
  variant?: 'light' | 'dark';
  iconSize?: number;
  wordmarkSize?: number;
  businessSize?: number;
}

const {
  variant = 'light',
  iconSize = variant === 'light' ? 30 : 26,
  wordmarkSize = variant === 'light' ? 22 : 20,
  businessSize = variant === 'light' ? 15 : 14,
} = Astro.props;

const isLight = variant === 'light';

// Monkey mark colors: "light" = ink monkey on cream (nav), "dark" = cream monkey on dark (footer).
const monkeyFace = isLight ? 'var(--ink)' : 'var(--bg-page)';
const earAccent = isLight ? 'var(--green)' : 'var(--green-light)';
const faceCutout = isLight ? 'var(--bg-page)' : 'var(--ink)';

const wordmarkColor = isLight ? 'var(--ink)' : 'var(--bg-page)';
const aiColor = isLight ? 'var(--green)' : 'var(--green-light)';
const businessColor = isLight ? 'var(--muted)' : 'var(--dark-dim)';

const iconHeight = Math.round((iconSize * 30) / 36);
---

<span class="logo">
  <svg
    width={iconSize}
    height={iconHeight}
    viewBox="0 0 36 30"
    aria-hidden="true"
    class="logo-mark"
    style={`--monkey-face:${monkeyFace}; --monkey-ear-accent:${earAccent}; --monkey-cutout:${faceCutout};`}
  >
    <circle cx="6" cy="15" r="4.6" fill="var(--monkey-face)"></circle>
    <circle cx="30" cy="15" r="4.6" fill="var(--monkey-face)"></circle>
    <circle cx="6" cy="15" r="2" fill="var(--monkey-ear-accent)"></circle>
    <circle cx="30" cy="15" r="2" fill="var(--monkey-ear-accent)"></circle>
    <circle cx="18" cy="15" r="11" fill="var(--monkey-face)"></circle>
    <circle cx="13.5" cy="12" r="4.4" fill="var(--monkey-cutout)"></circle>
    <circle cx="22.5" cy="12" r="4.4" fill="var(--monkey-cutout)"></circle>
    <ellipse cx="18" cy="17.5" rx="7" ry="6" fill="var(--monkey-cutout)"></ellipse>
    <circle cx="14.5" cy="13.5" r="1.5" fill="var(--monkey-face)"></circle>
    <circle cx="21.5" cy="13.5" r="1.5" fill="var(--monkey-face)"></circle>
    <circle cx="16.9" cy="17.6" r="0.9" fill="var(--monkey-face)"></circle>
    <circle cx="19.1" cy="17.6" r="0.9" fill="var(--monkey-face)"></circle>
    <path
      d="M14.8 20 Q18 23.2 21.2 20"
      stroke="var(--monkey-face)"
      stroke-width="1.3"
      fill="none"
      stroke-linecap="round"
    ></path>
  </svg>
  <span
    class="logo-wordmark"
    style={`--wordmark-color:${wordmarkColor}; --ai-color:${aiColor}; --business-color:${businessColor}; --wordmark-size:${wordmarkSize}px; --business-size:${businessSize}px;`}
  >
    Monk<span class="logo-ai">Ai</span> <span class="logo-business">Business</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .logo-mark {
    flex-shrink: 0;
  }
  .logo-wordmark {
    font-family: var(--font-serif);
    font-size: var(--wordmark-size);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--wordmark-color);
    white-space: nowrap;
  }
  .logo-ai {
    color: var(--ai-color);
  }
  .logo-business {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--business-size);
    color: var(--business-color);
  }
</style>
