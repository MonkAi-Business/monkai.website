---
import MonkeyMark from './MonkeyMark.astro';

export interface Props {
  variant?: 'light' | 'dark';
  iconSize?: number;
  wordmarkSize?: number;
  businessSize?: number;
  showBusiness?: boolean;
}

const {
  variant = 'light',
  iconSize = variant === 'light' ? 30 : 26,
  wordmarkSize = variant === 'light' ? 22 : 20,
  businessSize = variant === 'light' ? 15 : 14,
  showBusiness = true,
} = Astro.props;

const isLight = variant === 'light';

// Monkey mark colors: "light" = ink monkey on cream (nav), "dark" = cream monkey on dark (footer).
const monkeyFace = isLight ? 'var(--ink)' : 'var(--dark-bright)';
const earAccent = isLight ? 'var(--green)' : 'var(--green-light)';
const faceCutout = isLight ? 'var(--bg-page)' : 'var(--dark)';

const wordmarkColor = isLight ? 'var(--ink)' : 'var(--dark-bright)';
const aiColor = isLight ? 'var(--green)' : 'var(--green-light)';
const businessColor = isLight ? 'var(--muted)' : 'var(--dark-dim)';

const iconHeight = Math.round((iconSize * 30) / 36);
---

<span class="logo">
  <MonkeyMark
    width={iconSize}
    height={iconHeight}
    face={monkeyFace}
    earAccent={earAccent}
    cutout={faceCutout}
  />
  <span
    class="logo-wordmark"
    style={`--wordmark-color:${wordmarkColor}; --ai-color:${aiColor}; --business-color:${businessColor}; --wordmark-size:${wordmarkSize}px; --business-size:${businessSize}px;`}
  >
    Monk<span class="logo-ai">Ai</span>{showBusiness && <> <span class="logo-business">Business</span></>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .logo-wordmark {
    font-family: var(--font-serif);
    font-size: var(--wordmark-size);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--wordmark-color);
    white-space: nowrap;
  }
  .logo-ai {
    color: var(--ai-color);
  }
  .logo-business {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--business-size);
    color: var(--business-color);
  }
</style>
