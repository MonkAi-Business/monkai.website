---
import { problemCards } from '../data/home';
---
<section class="section problem">
  <div class="container problem-inner">
    <h2>Waar zit de monkey business bij jou?</h2>
    <div class="problem-grid">
      {problemCards.map((card) => (
        <div class="problem-card">
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .problem-inner { display:flex; flex-direction:column; gap:44px; }
  h2 { font-size:40px; font-weight:500; text-wrap:pretty; }
  .problem-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:24px; }
  .problem-card { background:var(--card); border:1px solid var(--border); border-radius:var(--radius); padding:30px; display:flex; flex-direction:column; gap:12px; }
  .problem-card h3 { font-size:22px; font-weight:600; }
  .problem-card p { margin:0; font-size:17px; line-height:1.65; color:var(--muted); }
  @media (max-width:768px){
    h2{ font-size:30px; }
    .problem-grid{ grid-template-columns:1fr; gap:14px; }
    .problem-card{ padding:24px; gap:8px; }
    .problem-card h3{ font-size:20px; }
    .problem-card p{ font-size:16px; }
  }
</style>
